<Slide style={{ width: 1280, height: 720, padding: '20px 72px', flexDirection: 'column', background: 'linear-gradient(160deg, #0B1220 0%, #16233D 100%)', fontFamily: '"Source Han Sans SC", "Noto Sans SC", "Microsoft YaHei", sans-serif' }}>
    {/* A 区 · 标题块 */}
    <Box style={{ height: 100, flexDirection: 'row', gap: 16, alignItems: 'flex-start', paddingTop: 6 }}>
        <Box style={{ width: 4, height: 36, background: '#2AD4EE', marginTop: 5 }} />
        <Box style={{ flexDirection: 'column' }}>
            <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#E8EEF9' }}>LLM 是「无状态的文本预测器」</Text>
            <Text style={{ marginTop: 8, fontSize: 17, color: 'rgba(232,238,249,0.52)' }}>理解这一点，才理解为什么 Agent 的上下文要自己算</Text>
        </Box>
    </Box>

    {/* B 区 · 左标题栏 + 右内容区 */}
    <Box style={{ height: 516, flexDirection: 'row', gap: 36 }}>
        {/* 左：定义栏 */}
        <Box style={{ width: 360, flexDirection: 'column', paddingRight: 30, borderRight: '1px solid rgba(232,238,249,0.12)' }}>
            <Text style={{ fontSize: 15, color: '#2AD4EE', letterSpacing: 3, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>DEFINITION</Text>
            <Text style={{ marginTop: 14, fontSize: 24, fontWeight: 'bold', color: '#E8EEF9', lineHeight: 1.45 }}>
                模型本身
                <br />
                没有内存
            </Text>
            <Text style={{ marginTop: 14, fontSize: 16, color: 'rgba(232,238,249,0.70)', lineHeight: 1.7 }}>
                它不会记住上一次对话。不把历史完整塞回 <span style={{ color: '#2AD4EE', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>messages</span>，它就不知道之前聊过什么——所谓「记忆」，每次请求都要你重建。
            </Text>
            <Box style={{ flexDirection: 'row', gap: 8, marginTop: 16, flexWrap: 'wrap' }}>
                {['无状态', '每次重发', 'messages 数组'].map((k, i) => (
                    <Box key={i} style={{ paddingTop: 4, paddingBottom: 4, paddingLeft: 10, paddingRight: 10, background: 'rgba(42,212,238,0.10)', borderRadius: 3 }}>
                        <Text style={{ fontSize: 14, color: '#2AD4EE' }}>{k}</Text>
                    </Box>
                ))}
            </Box>
            <Box style={{ marginTop: 18, height: 1, background: 'rgba(232,238,249,0.12)' }} />
            <Text style={{ marginTop: 14, fontSize: 15, color: 'rgba(232,238,249,0.52)', letterSpacing: 2, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>ACTIONS · 两个必做动作</Text>
            <Text style={{ marginTop: 10, fontSize: 15.5, color: 'rgba(232,238,249,0.70)', lineHeight: 1.7 }}>
                超窗之前：摘要压缩（compaction）
                <br />
                进上下文前：工具返回精简 + 脱敏
            </Text>
            <Box style={{ marginTop: 'auto', paddingTop: 12, paddingBottom: 12, paddingLeft: 16, paddingRight: 16, borderLeft: '3px solid #2AD4EE', background: 'rgba(42,212,238,0.06)' }}>
                <Text style={{ fontSize: 16, color: '#E8EEF9', lineHeight: 1.6 }}>
                    上下文窗口 = 一次能读完的
                    <span style={{ color: '#2AD4EE' }}>总量上限</span>
                    （输入 + 输出）。
                </Text>
            </Box>
        </Box>

        {/* 右：图示区 */}
        <Box style={{ flex: 1, flexDirection: 'column' }}>
            <Text style={{ fontSize: 15, color: 'rgba(232,238,249,0.52)', letterSpacing: 2, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>CONTEXT WINDOW · 以 128k token 为例</Text>

            <Box style={{ flexDirection: 'row', height: 78, marginTop: 16, borderRadius: 4, overflow: 'hidden', border: '1px solid rgba(42,212,238,0.22)' }}>
                <Box style={{ flex: 34, flexDirection: 'column', justifyContent: 'center', paddingLeft: 14, paddingRight: 10, background: 'rgba(42,212,238,0.16)', borderRight: '1px solid rgba(42,212,238,0.22)' }}>
                    <Text style={{ fontSize: 16, color: '#E8EEF9', fontWeight: '600' }}>历史对话</Text>
                    <Text style={{ fontSize: 13, color: 'rgba(232,238,249,0.62)', marginTop: 4 }}>system + 多轮 messages + 工具返回</Text>
                </Box>
                <Box style={{ flex: 14, flexDirection: 'column', justifyContent: 'center', paddingLeft: 12, paddingRight: 8, background: 'rgba(42,212,238,0.30)', borderRight: '1px solid rgba(42,212,238,0.22)' }}>
                    <Text style={{ fontSize: 16, color: '#0B1220', fontWeight: '600' }}>本轮输入</Text>
                    <Text style={{ fontSize: 13, color: 'rgba(11,18,32,0.72)', marginTop: 4 }}>用户问题</Text>
                </Box>
                <Box style={{ flex: 12, flexDirection: 'column', justifyContent: 'center', paddingLeft: 12, paddingRight: 8, background: 'rgba(42,212,238,0.06)' }}>
                    <Text style={{ fontSize: 16, color: 'rgba(232,238,249,0.78)', fontWeight: '600' }}>预留输出</Text>
                    <Text style={{ fontSize: 13, color: 'rgba(232,238,249,0.52)', marginTop: 4 }}>maxTokens</Text>
                </Box>
            </Box>

            <Box style={{ flexDirection: 'row', justifyContent: 'space-between', marginTop: 8 }}>
                <Text style={{ fontSize: 13, color: 'rgba(232,238,249,0.42)', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>0</Text>
                <Text style={{ fontSize: 13, color: 'rgba(232,238,249,0.42)' }}>超过上限 → 最前面的信息被丢弃</Text>
                <Text style={{ fontSize: 13, color: 'rgba(232,238,249,0.42)', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>128k</Text>
            </Box>

            <Text style={{ marginTop: 30, fontSize: 15, color: 'rgba(232,238,249,0.52)', letterSpacing: 2, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>TOKEN · 计费与窗口的最小单位</Text>
            <Text style={{ marginTop: 14, fontSize: 20, color: '#E8EEF9' }}>「企业 2025 年营收 3.2 亿元」</Text>
            <Box style={{ flexDirection: 'row', gap: 8, marginTop: 14, alignItems: 'center' }}>
                {['企业', '2025', '年', '营', '收', '3.2', '亿'].map((t, i) => (
                    <Box key={i} style={{ paddingTop: 5, paddingBottom: 5, paddingLeft: 11, paddingRight: 11, background: 'rgba(22,35,61,0.9)', border: '1px solid rgba(42,212,238,0.22)', borderRadius: 3 }}>
                        <Text style={{ fontSize: 15, color: '#2AD4EE', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>{t}</Text>
                    </Box>
                ))}
                <Text style={{ fontSize: 15, color: 'rgba(232,238,249,0.62)', marginLeft: 6 }}>→ 约 9 token（中文 1 汉字 ≈ 2 token）</Text>
            </Box>

            <Box style={{ marginTop: 'auto', flexDirection: 'row', alignItems: 'center', gap: 14, paddingTop: 16, paddingBottom: 16, paddingLeft: 18, paddingRight: 18, background: 'rgba(42,212,238,0.08)', border: '1px solid rgba(42,212,238,0.22)', borderRadius: 4 }}>
                <Text style={{ fontSize: 20, color: '#2AD4EE', fontWeight: 'bold', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>所以</Text>
                <Text style={{ fontSize: 18, color: '#E8EEF9', lineHeight: 1.6, flex: 1 }}>
                    Agent 多轮工具调用后上下文膨胀是<span style={{ color: '#2AD4EE' }}>必然</span>，不是意外——预算要自己管。
                </Text>
            </Box>
        </Box>
    </Box>

    {/* C 区 · 页脚 */}
    <Box style={{ height: 40, flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: 'rgba(232,238,249,0.42)' }}>从 LLM 到 Agent 再到 Pi Agent</Text>
        <Text style={{ fontSize: 14, color: 'rgba(232,238,249,0.42)', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>04 / 33</Text>
    </Box>
</Slide>
