<Slide style={{ width: 1280, height: 720, padding: '20px 72px', flexDirection: 'column', background: 'linear-gradient(160deg, #0B1220 0%, #16233D 100%)', fontFamily: '"Source Han Sans SC", "Noto Sans SC", "Microsoft YaHei", sans-serif' }}>
    {/* A 区 · 标题块 */}
    <Box style={{ height: 100, flexDirection: 'row', gap: 16, alignItems: 'flex-start', paddingTop: 6 }}>
        <Box style={{ width: 4, height: 36, background: '#2AD4EE', marginTop: 5 }} />
        <Box style={{ flexDirection: 'column' }}>
            <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#E8EEF9' }}>四个必须先记住的概念</Text>
            <Text style={{ marginTop: 8, fontSize: 17, color: 'rgba(232,238,249,0.52)' }}>它们分别管着 Agent 说什么、怎么说、会不会编、记不记得住</Text>
        </Box>
    </Box>

    {/* B 区 · 非对称双栏 62:38 */}
    <Box style={{ height: 516, flexDirection: 'row', gap: 36 }}>
        {/* 左：四个概念 */}
        <Box style={{ flex: 62, flexDirection: 'column', justifyContent: 'space-between', paddingRight: 34, borderRight: '1px solid rgba(232,238,249,0.12)' }}>
            {[
                { ic: 'file-text', t: 'Prompt · 提示词', d: '定角色、定任务、定边界、定输出格式。Agent 的 System Prompt 就是它的岗位说明书。' },
                { ic: 'cog', t: 'Temperature · 温度', d: '控制随机性。0 最确定，适合工具调用与结构化输出；0.7 有创造力；>1 容易胡编。' },
                { ic: 'exclamation-circle', t: '幻觉 · Hallucination', d: '模型会编造不存在的事实、参数、表名。压制的可靠办法只有一个：让它基于工具返回的真实数据作答。' },
                { ic: 'share', t: 'Embedding · 嵌入向量', d: '把文本转成向量，用相似度衡量语义远近（1 相似 / 0 无关 / -1 相反），是长期记忆的地基。' },
            ].map((c, i) => (
                <Box key={i} style={{ flexDirection: 'row', gap: 16, alignItems: 'flex-start', paddingTop: 10, paddingBottom: 10, borderBottom: i === 3 ? 'none' : '1px solid rgba(232,238,249,0.08)' }}>
                    <Box style={{ width: 42, height: 42, borderRadius: 4, background: 'rgba(42,212,238,0.10)', border: '1px solid rgba(42,212,238,0.22)', justifyContent: 'center', alignItems: 'center' }}>
                        <FAIcon name={c.ic} style={{ fill: '#2AD4EE', width: 21, height: 21 }} />
                    </Box>
                    <Box style={{ flexDirection: 'column', flex: 1 }}>
                        <Text style={{ fontSize: 20, fontWeight: '600', color: '#E8EEF9' }}>{c.t}</Text>
                        <Text style={{ marginTop: 6, fontSize: 16, color: 'rgba(232,238,249,0.66)', lineHeight: 1.6 }}>{c.d}</Text>
                    </Box>
                </Box>
            ))}
        </Box>

        {/* 右：串起来看 */}
        <Box style={{ flex: 38, flexDirection: 'column' }}>
            <Text style={{ fontSize: 15, color: '#2AD4EE', letterSpacing: 3, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>PUT TOGETHER</Text>
            <Text style={{ marginTop: 18, fontSize: 22, fontWeight: '600', color: '#E8EEF9', lineHeight: 1.5 }}>
                四个概念，
                <br />
                四道稳定性的闸门
            </Text>
            <Box style={{ marginTop: 24, flexDirection: 'column', gap: 12 }}>
                {[
                    { t: '说什么', v: 'Prompt', w: 100 },
                    { t: '怎么答', v: 'Temperature = 0', w: 78 },
                    { t: '会不会编', v: '工具真实数据', w: 62 },
                    { t: '记得住吗', v: 'Embedding + 向量库', w: 46 },
                ].map((r, i) => (
                    <Box key={i} style={{ flexDirection: 'column', gap: 6 }}>
                        <Box style={{ flexDirection: 'row', justifyContent: 'space-between' }}>
                            <Text style={{ fontSize: 16, color: 'rgba(232,238,249,0.70)' }}>{r.t}</Text>
                            <Text style={{ fontSize: 14, color: '#2AD4EE', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>{r.v}</Text>
                        </Box>
                        <Box style={{ height: 3, width: r.w + '%', background: 'linear-gradient(90deg, #2AD4EE 0%, #16233D 100%)' }} />
                    </Box>
                ))}
            </Box>
            <Box style={{ marginTop: 'auto', paddingTop: 16, paddingBottom: 16, paddingLeft: 18, paddingRight: 18, background: 'rgba(42,212,238,0.08)', border: '1px solid rgba(42,212,238,0.22)', borderRadius: 4 }}>
                <Text style={{ fontSize: 18, color: '#E8EEF9', lineHeight: 1.65 }}>
                    这四点决定了 Agent 的<span style={{ color: '#2AD4EE' }}>稳定性上限</span>——它们出问题，模型再强也救不回来。
                </Text>
            </Box>
        </Box>
    </Box>

    {/* C 区 · 页脚 */}
    <Box style={{ height: 40, flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: 'rgba(232,238,249,0.42)' }}>从 LLM 到 Agent 再到 Pi Agent</Text>
        <Text style={{ fontSize: 14, color: 'rgba(232,238,249,0.42)', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>05 / 33</Text>
    </Box>
</Slide>
