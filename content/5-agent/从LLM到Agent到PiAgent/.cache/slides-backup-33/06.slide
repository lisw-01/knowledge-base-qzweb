<Slide style={{ width: 1280, height: 720, padding: '20px 72px', flexDirection: 'column', background: 'linear-gradient(160deg, #0B1220 0%, #16233D 100%)', fontFamily: '"Source Han Sans SC", "Noto Sans SC", "Microsoft YaHei", sans-serif' }}>
    {/* A 区 · 标题块 */}
    <Box style={{ height: 100, flexDirection: 'row', gap: 16, alignItems: 'flex-start', paddingTop: 6 }}>
        <Box style={{ width: 4, height: 36, background: '#2AD4EE', marginTop: 5 }} />
        <Box style={{ flexDirection: 'column' }}>
            <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#E8EEF9' }}>两种调用方式：对话 vs 工具调用</Text>
            <Text style={{ marginTop: 8, fontSize: 17, color: 'rgba(232,238,249,0.52)' }}>从「只会说」到「能动手」，差别就在出口是文本还是结构化参数</Text>
        </Box>
    </Box>

    {/* B 区 */}
    <Box style={{ height: 516, flexDirection: 'column' }}>
        <Box style={{ flex: 1, flexDirection: 'row', gap: 36 }}>
            {/* 左：要点栏 */}
            <Box style={{ width: 340, flexDirection: 'column', paddingRight: 28, borderRight: '1px solid rgba(232,238,249,0.12)' }}>
                <Text style={{ fontSize: 15, color: '#2AD4EE', letterSpacing: 3, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>THE DIVIDE</Text>
                <Text style={{ marginTop: 16, fontSize: 30, fontWeight: 'bold', color: '#E8EEF9', lineHeight: 1.45 }}>
                    模型只说，
                    <br />
                    不做
                </Text>
                <Text style={{ marginTop: 18, fontSize: 17, color: 'rgba(232,238,249,0.70)', lineHeight: 1.75 }}>
                    两种方式里，模型都只负责「说要调什么」；真正执行函数的永远是我们的代码。这就是 Agent 安全的关键——<span style={{ color: '#2AD4EE' }}>模型没有权限，只有建议权</span>。
                </Text>
                <Box style={{ flexDirection: 'row', gap: 8, marginTop: 20, flexWrap: 'wrap' }}>
                    {['建议权在模型', '执行权在代码', '结构化参数'].map((k, i) => (
                        <Box key={i} style={{ paddingTop: 4, paddingBottom: 4, paddingLeft: 10, paddingRight: 10, background: 'rgba(42,212,238,0.10)', borderRadius: 3 }}>
                            <Text style={{ fontSize: 14, color: '#2AD4EE' }}>{k}</Text>
                        </Box>
                    ))}
                </Box>
            </Box>

            {/* 右：两条链路 */}
            <Box style={{ flex: 1, flexDirection: 'column', justifyContent: 'space-between' }}>
                {/* 链路 A */}
                <Box style={{ flexDirection: 'column' }}>
                    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                        <FAIcon name='comment' style={{ fill: 'rgba(232,238,249,0.42)', width: 16, height: 16 }} />
                        <Text style={{ fontSize: 17, color: 'rgba(232,238,249,0.70)', fontWeight: '600' }}>① 普通对话 · Chat Completions</Text>
                    </Box>
                    <Box style={{ flexDirection: 'row', alignItems: 'center', marginTop: 14 }}>
                        <Box style={{ width: 150, height: 80, justifyContent: 'center', alignItems: 'center', background: 'rgba(22,35,61,0.9)', border: '1px solid rgba(232,238,249,0.18)', borderRadius: 4 }}>
                            <Text style={{ fontSize: 16, color: '#E8EEF9' }}>用户输入</Text>
                            <Text style={{ fontSize: 13, color: 'rgba(232,238,249,0.52)', marginTop: 4 }}>messages 数组</Text>
                        </Box>
                        <Text style={{ fontSize: 20, color: 'rgba(232,238,249,0.42)', width: 46, textAlign: 'center' }}>→</Text>
                        <Box style={{ width: 150, height: 80, justifyContent: 'center', alignItems: 'center', background: 'rgba(22,35,61,0.9)', border: '1px solid rgba(232,238,249,0.18)', borderRadius: 4 }}>
                            <Text style={{ fontSize: 16, color: '#E8EEF9' }}>LLM</Text>
                            <Text style={{ fontSize: 13, color: 'rgba(232,238,249,0.52)', marginTop: 4 }}>生成</Text>
                        </Box>
                        <Text style={{ fontSize: 20, color: 'rgba(232,238,249,0.42)', width: 46, textAlign: 'center' }}>→</Text>
                        <Box style={{ width: 232, height: 80, justifyContent: 'center', alignItems: 'center', background: 'rgba(22,35,61,0.9)', border: '1px solid rgba(232,238,249,0.18)', borderRadius: 4 }}>
                            <Text style={{ fontSize: 16, color: 'rgba(232,238,249,0.62)' }}>纯文本输出</Text>
                            <Text style={{ fontSize: 13, color: 'rgba(232,238,249,0.42)', marginTop: 4 }}>程序只拿到一个字符串，到此为止</Text>
                        </Box>
                    </Box>
                </Box>

                {/* 链路 B */}
                <Box style={{ flexDirection: 'column' }}>
                    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                        <FAIcon name='bolt' style={{ fill: '#2AD4EE', width: 16, height: 16 }} />
                        <Text style={{ fontSize: 17, color: '#E8EEF9', fontWeight: '600' }}>② 工具调用 · Function Calling</Text>
                    </Box>
                    <Box style={{ flexDirection: 'row', alignItems: 'center', marginTop: 14 }}>
                        <Box style={{ width: 138, height: 96, justifyContent: 'center', alignItems: 'center', background: 'rgba(22,35,61,0.9)', border: '1px solid rgba(42,212,238,0.22)', borderRadius: 4 }}>
                            <Text style={{ fontSize: 16, color: '#E8EEF9' }}>用户输入</Text>
                            <Text style={{ fontSize: 13, color: 'rgba(232,238,249,0.52)', marginTop: 4 }}>「128×456 等于几」</Text>
                        </Box>
                        <Text style={{ fontSize: 20, color: '#2AD4EE', width: 36, textAlign: 'center' }}>→</Text>
                        <Box style={{ width: 178, height: 96, justifyContent: 'center', alignItems: 'center', background: 'rgba(42,212,238,0.14)', border: '1px solid rgba(42,212,238,0.35)', borderRadius: 4 }}>
                            <Text style={{ fontSize: 16, color: '#E8EEF9' }}>LLM 输出 tool_calls</Text>
                            <Text style={{ fontSize: 13, color: 'rgba(232,238,249,0.62)', marginTop: 4, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>JSON 参数</Text>
                        </Box>
                        <Text style={{ fontSize: 20, color: '#2AD4EE', width: 40, textAlign: 'center' }}>⇄</Text>
                        <Box style={{ width: 178, height: 96, justifyContent: 'center', alignItems: 'center', background: 'rgba(42,212,238,0.14)', border: '1px solid rgba(42,212,238,0.35)', borderRadius: 4 }}>
                            <Text style={{ fontSize: 16, color: '#E8EEF9' }}>你的代码真正执行</Text>
                            <Text style={{ fontSize: 13, color: 'rgba(232,238,249,0.62)', marginTop: 4 }}>role=tool 结果回填</Text>
                        </Box>
                        <Text style={{ fontSize: 20, color: '#2AD4EE', width: 36, textAlign: 'center' }}>→</Text>
                        <Box style={{ width: 138, height: 96, justifyContent: 'center', alignItems: 'center', background: 'rgba(42,212,238,0.22)', border: '1px solid rgba(42,212,238,0.35)', borderRadius: 4 }}>
                            <Text style={{ fontSize: 16, color: '#0B1220', fontWeight: '600' }}>最终回答</Text>
                            <Text style={{ fontSize: 13, color: 'rgba(11,18,32,0.72)', marginTop: 4, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>58368</Text>
                        </Box>
                    </Box>
                </Box>
            </Box>
        </Box>

        {/* 底部通栏 */}
        <Box style={{ height: 72, marginTop: 14, flexDirection: 'row', alignItems: 'center', gap: 16, paddingLeft: 20, paddingRight: 20, background: 'rgba(42,212,238,0.08)', border: '1px solid rgba(42,212,238,0.22)', borderRadius: 4 }}>
            <Text style={{ fontSize: 18, color: '#2AD4EE', fontWeight: 'bold', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>共同点</Text>
            <Box style={{ width: 1, height: 30, background: 'rgba(42,212,238,0.35)' }} />
            <Text style={{ fontSize: 18, color: '#E8EEF9', flex: 1, lineHeight: 1.6 }}>
                模型不碰真实世界，它只输出「调哪个工具、传什么参数」；执行永远发生在你的进程里——这就是工具调用成为「聊天机器人」与「Agent」分水岭的原因。
            </Text>
        </Box>
    </Box>

    {/* C 区 · 页脚 */}
    <Box style={{ height: 40, flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: 'rgba(232,238,249,0.42)' }}>从 LLM 到 Agent 再到 Pi Agent</Text>
        <Text style={{ fontSize: 14, color: 'rgba(232,238,249,0.42)', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>06 / 33</Text>
    </Box>
</Slide>
