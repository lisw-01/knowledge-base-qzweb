<Slide style={{ width: 1280, height: 720, padding: '20px 72px', flexDirection: 'column', background: 'linear-gradient(160deg, #0B1220 0%, #16233D 100%)', fontFamily: '"Source Han Sans SC", "Noto Sans SC", "Microsoft YaHei", sans-serif' }}>
    {/* A 区 · 标题块 */}
    <Box style={{ height: 100, flexDirection: 'row', gap: 16, alignItems: 'flex-start', paddingTop: 6 }}>
        <Box style={{ width: 4, height: 36, background: '#2AD4EE', marginTop: 5 }} />
        <Box style={{ flexDirection: 'column' }}>
            <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#E8EEF9' }}>ReAct：思考 → 行动 → 观察</Text>
            <Text style={{ marginTop: 8, fontSize: 17, color: 'rgba(232,238,249,0.52)' }}>Reasoning + Acting：让模型交替输出「思考」与「行动」，直到能回答</Text>
        </Box>
    </Box>

    {/* B 区 */}
    <Box style={{ height: 516, flexDirection: 'row', gap: 36 }}>
        {/* 左：要点栏 */}
        <Box style={{ width: 336, flexDirection: 'column', paddingRight: 28, borderRight: '1px solid rgba(232,238,249,0.12)' }}>
            <Text style={{ fontSize: 15, color: '#2AD4EE', letterSpacing: 3, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>REASONING + ACTING</Text>
            <Text style={{ marginTop: 16, fontSize: 28, fontWeight: 'bold', color: '#E8EEF9', lineHeight: 1.45 }}>
                一段话，
                <br />
                拆成思考与行动
            </Text>
            <Text style={{ marginTop: 18, fontSize: 17, color: 'rgba(232,238,249,0.70)', lineHeight: 1.75 }}>
                模型不再一次性给答案，而是交替输出「我要做什么」和「我调用什么工具」；系统执行后把结果作为 Observation 喂回去，模型再决定下一步。
            </Text>
            <Box style={{ flexDirection: 'row', gap: 8, marginTop: 18, flexWrap: 'wrap' }}>
                {['Thought', 'Action', 'Observation'].map((k, i) => (
                    <Box key={i} style={{ paddingTop: 4, paddingBottom: 4, paddingLeft: 10, paddingRight: 10, background: 'rgba(42,212,238,0.10)', borderRadius: 3 }}>
                        <Text style={{ fontSize: 13, color: '#2AD4EE', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>{k}</Text>
                    </Box>
                ))}
            </Box>
            <Box style={{ marginTop: 'auto', paddingTop: 14, paddingBottom: 14, paddingLeft: 16, paddingRight: 16, background: 'rgba(22,35,61,0.95)', border: '1px solid rgba(42,212,238,0.35)', borderRadius: 4 }}>
                <Text style={{ fontSize: 16, color: '#E8EEF9', lineHeight: 1.65 }}>
                    没有最大轮数兜底的 Agent，一次死循环就能烧掉一个月的 token 预算。
                </Text>
            </Box>
        </Box>

        {/* 右：循环回路 */}
        <Box style={{ flex: 1, flexDirection: 'column', justifyContent: 'space-between' }}>
            <Text style={{ fontSize: 15, color: 'rgba(232,238,249,0.52)', letterSpacing: 2, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>THE LOOP</Text>

            <Box style={{ flexDirection: 'row', alignItems: 'center', marginTop: 12 }}>
                {[
                    { t: '思考', e: 'Thought', d: '我要先查北京天气' },
                    { t: '行动', e: 'Action', d: 'get_weather[北京]' },
                    { t: '观察', e: 'Observation', d: '晴，28 度' },
                ].map((b, i) => (
                    <Box key={i} style={{ flexDirection: 'row', alignItems: 'center', flex: 1 }}>
                        <Box style={{ flex: 1, height: 116, flexDirection: 'column', justifyContent: 'center', paddingLeft: 18, paddingRight: 12, background: 'rgba(42,212,238,0.12)', border: '1px solid rgba(42,212,238,0.35)', borderRadius: 4 }}>
                            <Text style={{ fontSize: 22, fontWeight: '600', color: '#E8EEF9' }}>{b.t}</Text>
                            <Text style={{ marginTop: 4, fontSize: 13, color: '#2AD4EE', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>{b.e}</Text>
                            <Text style={{ marginTop: 10, fontSize: 15, color: 'rgba(232,238,249,0.66)', lineHeight: 1.5 }}>{b.d}</Text>
                        </Box>
                        {i < 2 && <Text style={{ fontSize: 22, color: '#2AD4EE', width: 44, textAlign: 'center' }}>→</Text>}
                    </Box>
                ))}
            </Box>

            <Box style={{ height: 52, marginTop: 16, flexDirection: 'row', alignItems: 'center', gap: 14, paddingLeft: 18, paddingRight: 18, background: 'rgba(22,35,61,0.9)', border: '1px dashed rgba(42,212,238,0.45)', borderRadius: 4 }}>
                <Text style={{ fontSize: 20, color: '#2AD4EE' }}>↺</Text>
                <Text style={{ fontSize: 16, color: 'rgba(232,238,249,0.78)' }}>还没拿到答案 → 带着 Observation 回到「思考」，进入下一轮</Text>
            </Box>

            <Box style={{ flexDirection: 'row', alignItems: 'center', marginTop: 16 }}>
                <Box style={{ width: 220, height: 84, flexDirection: 'column', justifyContent: 'center', alignItems: 'center', background: 'rgba(42,212,238,0.22)', border: '1px solid rgba(42,212,238,0.45)', borderRadius: 4 }}>
                    <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#0B1220' }}>回答</Text>
                    <Text style={{ marginTop: 4, fontSize: 13, color: 'rgba(11,18,32,0.72)', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>Answer</Text>
                </Box>
                <Text style={{ marginLeft: 18, fontSize: 16, color: 'rgba(232,238,249,0.62)', flex: 1 }}>证据足够 → 输出最终答案，退出循环</Text>
            </Box>

            <Box style={{ flexDirection: 'column', marginTop: 18 }}>
                <Text style={{ fontSize: 13, color: 'rgba(232,238,249,0.42)', letterSpacing: 3, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>终止条件 · 四个都要有</Text>
                <Box style={{ flexDirection: 'row', gap: 10, marginTop: 12 }}>
                    {['模型输出 Answer', '最大轮数', '超时', 'token 预算'].map((k, i) => (
                        <Box key={i} style={{ flex: 1, height: 48, justifyContent: 'center', alignItems: 'center', background: 'rgba(22,35,61,0.9)', border: '1px solid rgba(42,212,238,0.22)', borderRadius: 4 }}>
                            <Text style={{ fontSize: 15, color: '#E8EEF9' }}>{k}</Text>
                        </Box>
                    ))}
                </Box>
            </Box>
        </Box>
    </Box>

    {/* C 区 · 页脚 */}
    <Box style={{ height: 40, flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: 'rgba(232,238,249,0.42)' }}>从 LLM 到 Agent 再到 Pi Agent</Text>
        <Text style={{ fontSize: 14, color: 'rgba(232,238,249,0.42)', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>12 / 33</Text>
    </Box>
</Slide>
