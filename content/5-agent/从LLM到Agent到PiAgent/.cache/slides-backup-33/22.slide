<Slide style={{ width: 1280, height: 720, padding: '20px 72px', flexDirection: 'column', background: 'linear-gradient(160deg, #0B1220 0%, #16233D 100%)', fontFamily: '"Source Han Sans SC", "Noto Sans SC", "Microsoft YaHei", sans-serif' }}>
    {/* A 区 · 标题块 */}
    <Box style={{ height: 100, flexDirection: 'row', gap: 16, alignItems: 'flex-start', paddingTop: 6 }}>
        <Box style={{ width: 4, height: 36, background: '#2AD4EE', marginTop: 5 }} />
        <Box style={{ flexDirection: 'column' }}>
            <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#E8EEF9' }}>分层架构：严格单向的 monorepo</Text>
            <Text style={{ marginTop: 8, fontSize: 17, color: 'rgba(232,238,249,0.52)' }}>下层不知道上层，每一层都能单独拿出来用</Text>
        </Box>
    </Box>

    {/* B 区 · 左标题 + 右依赖图 */}
    <Box style={{ height: 516, flexDirection: 'row', gap: 34 }}>
        {/* 左：标题栏 */}
        <Box style={{ width: 268, flexDirection: 'column', paddingRight: 28, borderRight: '1px solid rgba(232,238,249,0.12)' }}>
            <Text style={{ fontSize: 15, color: '#2AD4EE', letterSpacing: 3, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>ARCHITECTURE</Text>
            <Text style={{ marginTop: 18, fontSize: 26, fontWeight: 'bold', color: '#E8EEF9', lineHeight: 1.45 }}>
                四层
                <br />
                单向依赖
            </Text>
            <Text style={{ marginTop: 18, fontSize: 16, color: 'rgba(232,238,249,0.72)', lineHeight: 1.8 }}>
                内核里没有 CLI、没有扩展、没有文件系统。<span style={{ color: '#E8EEF9', fontWeight: '600' }}>「组装」这件事，被完整地留在了最上面一层。</span>
            </Text>

            <Box style={{ marginTop: 20, flexDirection: 'column', gap: 9 }}>
                {[
                    '每层可独立发布，单独装也合法',
                    '可替换：换掉 pi-tui，内核一行不改',
                ].map((t, i) => (
                    <Box key={i} style={{ flexDirection: 'row', gap: 10, alignItems: 'center' }}>
                        <Box style={{ width: 5, height: 5, background: '#2AD4EE' }} />
                        <Text style={{ flex: 1, fontSize: 15, color: 'rgba(232,238,249,0.68)' }}>{t}</Text>
                    </Box>
                ))}
            </Box>

            <Box style={{ marginTop: 'auto', paddingTop: 16, paddingBottom: 16, paddingLeft: 16, paddingRight: 16, background: 'rgba(42,212,238,0.08)', border: '1px solid rgba(42,212,238,0.22)', borderRadius: 4 }}>
                <Text style={{ fontSize: 14, color: '#2AD4EE', letterSpacing: 3, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>所以</Text>
                <Text style={{ marginTop: 10, fontSize: 15.5, color: '#E8EEF9', lineHeight: 1.7 }}>
                    做编码类产品，直接用
                    <span style={{ color: '#2AD4EE', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}> coding-agent</span>
                    ；只要裸内核，用
                    <span style={{ color: '#2AD4EE', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>agent-core</span>
                    。
                </Text>
            </Box>
        </Box>

        {/* 右：四层依赖图 */}
        <Box style={{ flex: 1, flexDirection: 'column' }}>
            <Box style={{ flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
                <Text style={{ fontSize: 15, color: 'rgba(232,238,249,0.52)', letterSpacing: 2, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>PACKAGE DEPENDENCY · 箭头 = 依赖方向</Text>
                <Text style={{ fontSize: 13, color: 'rgba(232,238,249,0.42)' }}>上层可以依赖下层，反之不成立</Text>
            </Box>

            <Box style={{ flex: 1, marginTop: 12, flexDirection: 'column', justifyContent: 'space-between' }}>
                {[
                    { tag: 'UI', name: 'pi-tui', role: '终端差分渲染 UI', d: '独立包，不直接 import 内核；换成自己的前端同样成立', top: true },
                    { tag: 'L3', name: 'pi-coding-agent', role: '产品运行时组装层 · SDK 入口', d: '组装内核 + 内置编码工具 + 会话持久化 + 扩展扫描 + 多运行模式', top: false },
                    { tag: 'L2', name: 'pi-agent-core', role: 'Agent 纯内核层', d: 'Agent Loop · 工具抽象与调度 · 事件总线 · 终止与最大轮次控制', top: false },
                    { tag: 'L1', name: 'pi-ai', role: 'Unified LLM 统一模型接入层', d: '多 Provider 适配 · 流式 chunk 归一化 · 工具 schema · 凭证管理', top: false },
                ].map((l, i) => (
                    <Box key={i} style={{ flexDirection: 'column', flex: 1 }}>
                        <Box style={{ flex: 1, flexDirection: 'row', alignItems: 'center', gap: 18, paddingLeft: 18, paddingRight: 18, background: l.top ? 'rgba(22,35,61,0.82)' : 'rgba(22,35,61,0.95)', border: l.top ? '1px dashed rgba(232,238,249,0.20)' : '1px solid rgba(42,212,238,0.30)', borderLeft: l.top ? '1px dashed rgba(232,238,249,0.20)' : '3px solid #2AD4EE', borderRadius: 3 }}>
                            <Text style={{ width: 34, fontSize: 16, color: 'rgba(42,212,238,0.85)', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>{l.tag}</Text>
                            <Box style={{ flexDirection: 'column', flex: 1 }}>
                                <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 12 }}>
                                    <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#E8EEF9', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>{l.name}</Text>
                                    <Text style={{ fontSize: 15, color: 'rgba(232,238,249,0.62)' }}>{l.role}</Text>
                                </Box>
                                <Text style={{ marginTop: 6, fontSize: 13.5, color: 'rgba(232,238,249,0.50)', lineHeight: 1.5 }}>{l.d}</Text>
                            </Box>
                        </Box>
                        {i < 3 && (
                            <Box style={{ height: 22, flexDirection: 'row', alignItems: 'center', paddingLeft: 40, gap: 10 }}>
                                <Text style={{ fontSize: 14, color: '#2AD4EE', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>↓ depends on</Text>
                            </Box>
                        )}
                    </Box>
                ))}
            </Box>

            <Box style={{ height: 44, marginTop: 10, flexDirection: 'row', alignItems: 'center', gap: 12, paddingLeft: 16, paddingRight: 16, background: 'rgba(42,212,238,0.06)', borderLeft: '3px solid rgba(42,212,238,0.55)' }}>
                <Text style={{ fontSize: 14, color: '#2AD4EE', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>OPTIONAL</Text>
                <Text style={{ fontSize: 14.5, color: 'rgba(232,238,249,0.70)' }}>
                    另有可选的 CBOR 远程会话栈：pi-protocol · pi-client · pi-server，独立叠加，不影响核心四层。
                </Text>
            </Box>
        </Box>
    </Box>

    {/* C 区 · 页脚 */}
    <Box style={{ height: 40, flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: 'rgba(232,238,249,0.42)' }}>从 LLM 到 Agent 再到 Pi Agent</Text>
        <Text style={{ fontSize: 14, color: 'rgba(232,238,249,0.42)', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>22 / 33</Text>
    </Box>
</Slide>
