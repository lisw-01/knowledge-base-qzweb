<Slide style={{ width: 1280, height: 720, padding: '20px 72px', flexDirection: 'column', background: 'linear-gradient(160deg, #0B1220 0%, #16233D 100%)', fontFamily: '"Source Han Sans SC", "Noto Sans SC", "Microsoft YaHei", sans-serif' }}>
    {/* A 区 · 标题块 */}
    <Box style={{ height: 100, flexDirection: 'row', gap: 16, alignItems: 'flex-start', paddingTop: 6 }}>
        <Box style={{ width: 4, height: 36, background: '#2AD4EE', marginTop: 5 }} />
        <Box style={{ flexDirection: 'column' }}>
            <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#E8EEF9' }}>一次调用的完整数据流</Text>
            <Text style={{ marginTop: 8, fontSize: 17, color: 'rgba(232,238,249,0.52)' }}>从一句话输入，到 agent_end，中间到底发生了什么</Text>
        </Box>
    </Box>

    {/* B 区 */}
    <Box style={{ height: 516, flexDirection: 'column' }}>
        <Text style={{ fontSize: 15, color: '#2AD4EE', letterSpacing: 3, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>REQUEST LIFECYCLE · 事件回流贯穿全程</Text>

        {/* 主链路 */}
        <Box style={{ flex: 1, marginTop: 14, flexDirection: 'row', alignItems: 'center', gap: 0 }}>
            {[
                { n: '01', t: '用户输入', d: '自然语言需求' },
                { n: '02', t: 'AgentSession', d: '.prompt 入队' },
                { n: '03', t: '双层 while', d: '内层工具 / 外层续跑' },
                { n: '04', t: '上下文转换', d: 'transformContext' },
                { n: '05', t: '流式请求', d: 'streamSimple' },
                { n: '06', t: '事件回流', d: '事件总线 → UI' },
                { n: '07', t: 'agent_end', d: '本轮结束' },
            ].map((s, i) => (
                <Box key={i} style={{ flex: 1, flexDirection: 'row', alignItems: 'center' }}>
                    <Box style={{ flex: 1, flexDirection: 'column', paddingTop: 14, paddingBottom: 14, paddingLeft: 12, paddingRight: 12, background: i === 6 ? 'rgba(42,212,238,0.14)' : 'rgba(22,35,61,0.95)', border: i === 6 ? '1px solid rgba(42,212,238,0.45)' : '1px solid rgba(232,238,249,0.12)', borderTop: i === 2 || i === 3 ? '2px solid #2AD4EE' : undefined, borderRadius: 3 }}>
                        <Text style={{ fontSize: 13, color: '#2AD4EE', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>{s.n}</Text>
                        <Text style={{ marginTop: 8, fontSize: 17, fontWeight: 'bold', color: '#E8EEF9', lineHeight: 1.3 }}>{s.t}</Text>
                        <Text style={{ marginTop: 6, fontSize: 12.5, color: 'rgba(232,238,249,0.55)', lineHeight: 1.45, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>{s.d}</Text>
                    </Box>
                    {i < 6 && <Text style={{ width: 20, textAlign: 'center', fontSize: 15, color: 'rgba(42,212,238,0.75)' }}>›</Text>}
                </Box>
            ))}
        </Box>

        {/* 工具管线四阶段 */}
        <Box style={{ height: 150, marginTop: 18, flexDirection: 'column', paddingTop: 14, paddingBottom: 14, paddingLeft: 18, paddingRight: 18, background: 'rgba(42,212,238,0.05)', border: '1px solid rgba(42,212,238,0.22)', borderRadius: 4 }}>
            <Box style={{ flexDirection: 'row', alignItems: 'baseline', justifyContent: 'space-between' }}>
                <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#E8EEF9' }}>步骤 ③ 展开 · 工具管线的四个阶段</Text>
                <Text style={{ fontSize: 13, color: 'rgba(232,238,249,0.45)' }}>所有「每次工具调用都要做的事」都被收进这一层</Text>
            </Box>
            <Box style={{ flex: 1, marginTop: 12, flexDirection: 'row', alignItems: 'stretch', gap: 12 }}>
                {[
                    { t: 'Prepare', d: '参数校验 + beforeToolCall 拦截', s: '工具还没跑，先验一遍' },
                    { t: 'Execute', d: 'execute() + onUpdate 进度回调', s: '真正干活的一步' },
                    { t: 'Finalize', d: 'afterToolCall 改写 / 脱敏', s: '结果进上下文前先过一道' },
                    { t: '截断保护', d: '超长结果裁剪后回喂', s: '别让一条返回撑爆窗口' },
                ].map((p, i) => (
                    <Box key={i} style={{ flex: 1, flexDirection: 'column', justifyContent: 'center', paddingLeft: 14, paddingRight: 14, background: 'rgba(22,35,61,0.95)', borderLeft: '3px solid rgba(42,212,238,0.75)', borderRadius: 3 }}>
                        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#2AD4EE', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>{p.t}</Text>
                        <Text style={{ marginTop: 8, fontSize: 13.5, color: 'rgba(232,238,249,0.72)', lineHeight: 1.5 }}>{p.d}</Text>
                        <Text style={{ marginTop: 6, fontSize: 12.5, color: 'rgba(232,238,249,0.45)' }}>{p.s}</Text>
                    </Box>
                ))}
            </Box>
        </Box>

        {/* 下方两卡 */}
        <Box style={{ height: 128, marginTop: 16, flexDirection: 'row', gap: 20 }}>
            <Box style={{ flex: 58, flexDirection: 'column', justifyContent: 'center', paddingLeft: 20, paddingRight: 20, background: 'rgba(22,35,61,0.92)', border: '1px solid rgba(232,238,249,0.12)', borderRadius: 4 }}>
                <Text style={{ fontSize: 15, color: 'rgba(232,238,249,0.45)', letterSpacing: 2, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>WHY TWO LOOPS</Text>
                <Text style={{ marginTop: 10, fontSize: 15.5, color: 'rgba(232,238,249,0.74)', lineHeight: 1.7 }}>
                    <span style={{ color: '#E8EEF9', fontWeight: '600' }}>内层</span>在一轮里反复「模型 → 工具 → 结果」，直到模型不再要工具；
                    <span style={{ color: '#E8EEF9', fontWeight: '600' }}>外层</span>负责续跑——用户的插话与追问变成队列消息注入，而不是硬中断。
                </Text>
            </Box>
            <Box style={{ flex: 42, flexDirection: 'column', justifyContent: 'center', paddingLeft: 20, paddingRight: 20, background: 'rgba(42,212,238,0.08)', border: '1px solid rgba(42,212,238,0.28)', borderRadius: 4 }}>
                <Text style={{ fontSize: 15, color: '#2AD4EE', letterSpacing: 3, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>所以</Text>
                <Text style={{ marginTop: 10, fontSize: 17, color: '#E8EEF9', lineHeight: 1.65 }}>
                    看懂了这条流，就懂了 Pi 的<span style={{ color: '#2AD4EE' }}>一切扩展点</span>。
                </Text>
            </Box>
        </Box>
    </Box>

    {/* C 区 · 页脚 */}
    <Box style={{ height: 40, flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: 'rgba(232,238,249,0.42)' }}>从 LLM 到 Agent 再到 Pi Agent</Text>
        <Text style={{ fontSize: 14, color: 'rgba(232,238,249,0.42)', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>23 / 33</Text>
    </Box>
</Slide>
