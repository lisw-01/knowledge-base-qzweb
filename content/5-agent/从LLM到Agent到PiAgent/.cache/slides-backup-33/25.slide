<Slide style={{ width: 1280, height: 720, padding: '20px 72px', flexDirection: 'column', background: 'linear-gradient(160deg, #0B1220 0%, #16233D 100%)', fontFamily: '"Source Han Sans SC", "Noto Sans SC", "Microsoft YaHei", sans-serif' }}>
    {/* A 区 · 标题块 */}
    <Box style={{ height: 100, flexDirection: 'row', gap: 16, alignItems: 'flex-start', paddingTop: 6 }}>
        <Box style={{ width: 4, height: 36, background: '#2AD4EE', marginTop: 5 }} />
        <Box style={{ flexDirection: 'column' }}>
            <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#E8EEF9' }}>三层定制能力</Text>
            <Text style={{ marginTop: 8, fontSize: 17, color: 'rgba(232,238,249,0.52)' }}>投入成本从小时级到周级，按需选路线</Text>
        </Box>
    </Box>

    {/* B 区 · 非对称双栏 60:40 */}
    <Box style={{ height: 516, flexDirection: 'row', gap: 32 }}>
        {/* 左：三条路线 */}
        <Box style={{ flex: 60, flexDirection: 'column', paddingRight: 30, borderRight: '1px solid rgba(232,238,249,0.12)' }}>
            <Box style={{ flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
                <Text style={{ fontSize: 15, color: '#2AD4EE', letterSpacing: 3, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>THREE ROUTES</Text>
                <Text style={{ fontSize: 13, color: 'rgba(232,238,249,0.42)' }}>越往下，改动越深、成本越高</Text>
            </Box>

            <Box style={{ flex: 1, marginTop: 12, flexDirection: 'column', justifyContent: 'space-between' }}>
                {[
                    { n: '路线 1', t: 'Skills', layer: '提示词层', cost: '小时级', i: 'file-lines', d: '一个遵循开放 Agent Skills 标准的 Markdown 文件夹，描述「遇到某类任务该怎么做」。模型按需自动加载，不占常驻上下文。', hint: '.pi/skills/release-checklist/SKILL.md' },
                    { n: '路线 2', t: 'Extensions', layer: '运行时层', cost: '天级', i: 'puzzle-piece', d: '用 TypeScript 写扩展：给 Agent 加自定义工具，或修改运行时行为——在工具调用前后插入自己的校验与拦截。', hint: '.pi/extensions/*.ts' },
                    { n: '路线 3', t: 'SDK', layer: '进程内嵌层', cost: '周级', i: 'code', d: 'createAgentSession 在调用方进程内构建完整会话，可注入存储、配置、认证、模型注册表与工具。', hint: '无桥接 · 无子进程 · 无 socket' },
                ].map((c, i) => (
                    <Box key={i} style={{ flex: 1, flexDirection: 'row', gap: 16, alignItems: 'center', paddingTop: 12, paddingBottom: 12, paddingLeft: 16, paddingRight: 16, background: 'rgba(22,35,61,0.88)', borderLeft: '3px solid rgba(42,212,238,0.7)', borderRadius: 3 }}>
                        <Box style={{ width: 42, height: 42, borderRadius: 4, background: 'rgba(42,212,238,0.12)', alignItems: 'center', justifyContent: 'center' }}>
                            <FAIcon name={c.i} style={{ fill: '#2AD4EE', width: 19, height: 19 }} />
                        </Box>
                        <Box style={{ flex: 1, flexDirection: 'column' }}>
                            <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 10 }}>
                                <Text style={{ fontSize: 13, color: 'rgba(42,212,238,0.75)', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>{c.n}</Text>
                                <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#E8EEF9' }}>{c.t}</Text>
                                <Text style={{ fontSize: 13, color: 'rgba(232,238,249,0.5)' }}>{c.layer}</Text>
                            </Box>
                            <Text style={{ marginTop: 8, fontSize: 14.5, color: 'rgba(232,238,249,0.68)', lineHeight: 1.6 }}>{c.d}</Text>
                            <Text style={{ marginTop: 7, fontSize: 12.5, color: 'rgba(42,212,238,0.72)', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>{c.hint}</Text>
                        </Box>
                        <Box style={{ paddingTop: 4, paddingBottom: 4, paddingLeft: 10, paddingRight: 10, background: 'rgba(42,212,238,0.10)', border: '1px solid rgba(42,212,238,0.30)', borderRadius: 3 }}>
                            <Text style={{ fontSize: 13, color: '#2AD4EE' }}>{c.cost}</Text>
                        </Box>
                    </Box>
                ))}
            </Box>
        </Box>

        {/* 右：成本梯度 + 判断 */}
        <Box style={{ flex: 40, flexDirection: 'column' }}>
            <Text style={{ fontSize: 15, color: 'rgba(232,238,249,0.52)', letterSpacing: 2, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>COST LADDER</Text>

            <Box style={{ marginTop: 16, flexDirection: 'column', gap: 16 }}>
                {[
                    { l: 'Skills', c: '小时级', w: '34%' },
                    { l: 'Extensions', c: '天级', w: '66%' },
                    { l: 'SDK', c: '周级', w: '100%' },
                ].map((r, i) => (
                    <Box key={i} style={{ flexDirection: 'column', gap: 7 }}>
                        <Box style={{ flexDirection: 'row', alignItems: 'baseline', justifyContent: 'space-between' }}>
                            <Text style={{ fontSize: 15, fontWeight: '600', color: '#E8EEF9', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>{r.l}</Text>
                            <Text style={{ fontSize: 14, color: '#2AD4EE' }}>{r.c}</Text>
                        </Box>
                        <Box style={{ height: 9, width: r.w, background: 'linear-gradient(90deg, #2AD4EE 0%, rgba(42,212,238,0.18) 100%)', borderRadius: 2 }} />
                    </Box>
                ))}
            </Box>

            <Box style={{ marginTop: 24, paddingTop: 16, paddingBottom: 16, paddingLeft: 16, paddingRight: 16, background: 'rgba(22,35,61,0.92)', border: '1px solid rgba(232,238,249,0.12)', borderRadius: 4 }}>
                <Text style={{ fontSize: 14, color: 'rgba(232,238,249,0.45)', letterSpacing: 2, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>ASK FIRST</Text>
                <Text style={{ marginTop: 10, fontSize: 15.5, color: 'rgba(232,238,249,0.76)', lineHeight: 1.7 }}>
                    绝大多数团队需求，停在
                    <span style={{ color: '#2AD4EE', fontWeight: '600' }}> Skills </span>
                    就够了——先把经验写成文档，再谈改代码。
                </Text>
            </Box>

            <Box style={{ marginTop: 'auto', paddingTop: 16, paddingBottom: 16, paddingLeft: 16, paddingRight: 16, background: 'rgba(42,212,238,0.08)', border: '1px solid rgba(42,212,238,0.22)', borderRadius: 4 }}>
                <Text style={{ fontSize: 14, color: '#2AD4EE', letterSpacing: 3, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>所以</Text>
                <Text style={{ marginTop: 10, fontSize: 16, color: '#E8EEF9', lineHeight: 1.7 }}>
                    先问「我要改造哪一层」，再选路线——不要一上来就走最深的那条。
                </Text>
            </Box>
        </Box>
    </Box>

    {/* C 区 · 页脚 */}
    <Box style={{ height: 40, flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: 'rgba(232,238,249,0.42)' }}>从 LLM 到 Agent 再到 Pi Agent</Text>
        <Text style={{ fontSize: 14, color: 'rgba(232,238,249,0.42)', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>25 / 33</Text>
    </Box>
</Slide>
