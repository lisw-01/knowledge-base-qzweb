<Slide style={{ width: 1280, height: 720, padding: '20px 72px', flexDirection: 'column', background: 'linear-gradient(160deg, #0B1220 0%, #16233D 100%)', fontFamily: '"Source Han Sans SC", "Noto Sans SC", "Microsoft YaHei", sans-serif' }}>
    {/* A 区 · 标题块 */}
    <Box style={{ height: 100, flexDirection: 'row', gap: 16, alignItems: 'flex-start', paddingTop: 6 }}>
        <Box style={{ width: 4, height: 36, background: '#2AD4EE', marginTop: 5 }} />
        <Box style={{ flexDirection: 'column' }}>
            <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#E8EEF9' }}>踩坑实录：四个真实 Bug</Text>
            <Text style={{ marginTop: 8, fontSize: 17, color: 'rgba(232,238,249,0.52)' }}>现象 · 根因 · 修法，一个不少地记下来</Text>
        </Box>
    </Box>

    {/* B 区 · 左标题 + 右 2×2 */}
    <Box style={{ height: 516, flexDirection: 'row', gap: 30 }}>
        {/* 左：标题栏 */}
        <Box style={{ width: 262, flexDirection: 'column', paddingRight: 26, borderRight: '1px solid rgba(232,238,249,0.12)' }}>
            <Text style={{ fontSize: 15, color: '#2AD4EE', letterSpacing: 3, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>POSTMORTEM</Text>
            <Text style={{ marginTop: 18, fontSize: 26, fontWeight: 'bold', color: '#E8EEF9', lineHeight: 1.45 }}>
                四个 Bug
                <br />
                四条边界
            </Text>
            <Text style={{ marginTop: 18, fontSize: 16, color: 'rgba(232,238,249,0.72)', lineHeight: 1.8 }}>
                这四个坑没有一个是"模型不行"。全部出在加载方式、订阅生命周期、错误传播与空结果的边界上。
            </Text>
            <Box style={{ marginTop: 'auto', paddingTop: 16, paddingBottom: 16, paddingLeft: 16, paddingRight: 16, background: 'rgba(42,212,238,0.08)', border: '1px solid rgba(42,212,238,0.22)', borderRadius: 4 }}>
                <Text style={{ fontSize: 14, color: '#2AD4EE', letterSpacing: 3, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>所以</Text>
                <Text style={{ marginTop: 10, fontSize: 15.5, color: '#E8EEF9', lineHeight: 1.7 }}>
                    Agent 的坑大多不在模型，在<span style={{ color: '#2AD4EE' }}>边界</span>。
                </Text>
            </Box>
        </Box>

        {/* 右：2×2 卡片 */}
        <Box style={{ flex: 1, flexDirection: 'column', gap: 16 }}>
            {[
                [
                    { n: '01', i: 'bug', t: '上下文在工具里读不到', c: '根因', cd: '.pi 扩展由 jiti(CJS) 加载，对 context 的 import 是独立编译副本，AsyncLocalStorage 实例被隔离，工具内 getCtx() 永远失败。', f: '修法', fd: '不打补丁——删掉 ALS，会话上下文沿调用链显式传参。' },
                    { n: '02', i: 'clone', t: '每个字都重复两遍', c: '根因', cd: 'EventBus.attach 二次调用时，旧订阅的 unsubscribe 引用被覆盖却从未调用，新旧回调并存，每个事件 emit 两遍。', f: '修法', fd: 'attach 开头先 detach 旧回调，保证任一时刻只有一个订阅者。' },
                ],
                [
                    { n: '03', i: 'circle-exclamation', t: '页面空白，模型"没有输出"', c: '根因', cd: '模型层 429（余额 / 限流）被内部重试 3 次后放弃，prompt() 不抛异常，错误全程静默。', f: '修法', fd: 'message_end 分支兜底：stopReason = error 时补推 SSE error，页面直接显示失败原因。' },
                    { n: '04', i: 'ban', t: '无数据时反复换参重试', c: '根因', cd: '模型很难接受"空结果"，会降级改 SQL 或换参数重来，既浪费轮次，也可能编造数据。', f: '修法', fd: '双层熔断：软引导下发终止指令，硬熔断由服务端直接拒绝二次调用。' },
                ],
            ].map((row, ri) => (
                <Box key={ri} style={{ flex: 1, flexDirection: 'row', gap: 24 }}>
                    {row.map((k, ki) => (
                        <Box key={ki} style={{ flex: 1, flexDirection: 'column', paddingTop: 14, paddingBottom: 14, paddingLeft: 16, paddingRight: 16, background: 'rgba(22,35,61,0.92)', border: '1px solid rgba(232,238,249,0.10)', borderTop: '3px solid rgba(42,212,238,0.75)', borderRadius: 3 }}>
                            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
                                <Text style={{ fontSize: 26, color: '#2AD4EE', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace', lineHeight: 1 }}>{k.n}</Text>
                                <FAIcon name={k.i} style={{ fill: 'rgba(42,212,238,0.85)', width: 15, height: 15 }} />
                                <Text style={{ flex: 1, fontSize: 16.5, fontWeight: 'bold', color: '#E8EEF9', lineHeight: 1.35 }}>{k.t}</Text>
                            </Box>
                            <Box style={{ marginTop: 'auto', flexDirection: 'column', gap: 8 }}>
                                <Text style={{ fontSize: 13.5, color: 'rgba(232,238,249,0.66)', lineHeight: 1.6 }}>
                                    <span style={{ color: '#2AD4EE', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace', fontSize: 12.5 }}>{k.c} </span>
                                    {k.cd}
                                </Text>
                                <Text style={{ fontSize: 13.5, color: 'rgba(232,238,249,0.80)', lineHeight: 1.6 }}>
                                    <span style={{ color: '#2AD4EE', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace', fontSize: 12.5 }}>{k.f} </span>
                                    {k.fd}
                                </Text>
                            </Box>
                        </Box>
                    ))}
                </Box>
            ))}
        </Box>
    </Box>

    {/* C 区 · 页脚 */}
    <Box style={{ height: 40, flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: 'rgba(232,238,249,0.42)' }}>从 LLM 到 Agent 再到 Pi Agent</Text>
        <Text style={{ fontSize: 14, color: 'rgba(232,238,249,0.42)', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>33 / 34</Text>
    </Box>
</Slide>
