<Slide style={{ width: 1280, height: 720, padding: '20px 72px', flexDirection: 'column', background: 'linear-gradient(160deg, #0B1220 0%, #16233D 100%)', fontFamily: '"Source Han Sans SC", "Noto Sans SC", "Microsoft YaHei", sans-serif' }}>
    {/* A 区 · 标题块 */}
    <Box style={{ height: 100, flexDirection: 'row', gap: 16, alignItems: 'flex-start', paddingTop: 6 }}>
        <Box style={{ width: 4, height: 36, background: '#2AD4EE', marginTop: 5 }} />
        <Box style={{ flexDirection: 'column' }}>
            <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#E8EEF9' }}>逐层拆解：每层到底要写什么</Text>
            <Text style={{ marginTop: 8, fontSize: 17, color: 'rgba(232,238,249,0.52)' }}>少写一层，问题就会以最难查的方式冒出来</Text>
        </Box>
    </Box>

    {/* B 区 · 左标题 + 右内容 */}
    <Box style={{ height: 516, flexDirection: 'row', gap: 34 }}>
        {/* 左：标题栏 */}
        <Box style={{ width: 292, flexDirection: 'column', paddingRight: 30, borderRight: '1px solid rgba(232,238,249,0.12)' }}>
            <Text style={{ fontSize: 15, color: '#2AD4EE', letterSpacing: 3, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>LAYER BY LAYER</Text>
            <Text style={{ marginTop: 18, fontSize: 26, fontWeight: 'bold', color: '#E8EEF9', lineHeight: 1.45 }}>
                把七层
                <br />
                摊成一张清单
            </Text>
            <Text style={{ marginTop: 18, fontSize: 16, color: 'rgba(232,238,249,0.72)', lineHeight: 1.75 }}>
                每一层都有必须落地的动作项。它们不写进代码，就会在某个凌晨的线上事故里，以最难查的方式出现。
            </Text>
            <Box style={{ marginTop: 'auto', paddingTop: 16, paddingBottom: 16, paddingLeft: 16, paddingRight: 16, background: 'rgba(42,212,238,0.08)', border: '1px solid rgba(42,212,238,0.22)', borderRadius: 4 }}>
                <Text style={{ fontSize: 14, color: '#2AD4EE', letterSpacing: 3, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>所以</Text>
                <Text style={{ marginTop: 10, fontSize: 16, color: '#E8EEF9', lineHeight: 1.7 }}>
                    ①~⑤ 写不好，系统跑不起来；
                    <br />
                    ⑥~⑦ 不写，系统跑起来之后你不敢让人用。
                </Text>
            </Box>
        </Box>

        {/* 右：7 层动作项 */}
        <Box style={{ flex: 1, flexDirection: 'row', gap: 24 }}>
            {[
                [
                    { n: '①', t: '模型', i: 'microchip', d: '密钥与多模型切换 · 超时重试与降级 · 流式输出' },
                    { n: '②', t: '提示', i: 'comment-dots', d: '角色 / 目标 / 边界 / 输出格式 · 少样本示例 · 系统提示版本化' },
                    { n: '③', t: '工具', i: 'wrench', d: 'JSON Schema 描述 · 参数类型与范围校验 · 错误信息回喂' },
                    { n: '④', t: '记忆', i: 'layer-group', d: '上下文裁剪与摘要压缩 · 事实卡片 · 向量检索 topK' },
                ],
                [
                    { n: '⑤', t: '控制', i: 'arrows-rotate', d: '四个终止条件：Answer / 最大轮数 / 超时 / token 预算' },
                    { n: '⑥', t: '护栏', i: 'shield-halved', d: '输入审查 · 输出脱敏 · 高危操作二次确认' },
                    { n: '⑦', t: '运营', i: 'chart-line', d: '全链路日志与耗时 · token 成本统计 · 离线评测集' },
                ],
            ].map((col, ci) => (
                <Box key={ci} style={{ flex: 1, flexDirection: 'column', gap: 10 }}>
                    {col.map((r, i) => (
                        <Box key={i} style={{ flex: 1, flexDirection: 'row', gap: 12, alignItems: 'center', paddingTop: 12, paddingBottom: 12, paddingLeft: 14, paddingRight: 14, background: 'rgba(22,35,61,0.85)', borderLeft: '2px solid rgba(42,212,238,0.55)', borderRadius: 3 }}>
                            <FAIcon name={r.i} style={{ fill: '#2AD4EE', width: 17, height: 17 }} />
                            <Box style={{ flexDirection: 'column', flex: 1 }}>
                                <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 8 }}>
                                    <Text style={{ fontSize: 15, color: '#2AD4EE', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>{r.n}</Text>
                                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#E8EEF9' }}>{r.t}</Text>
                                </Box>
                                <Text style={{ marginTop: 6, fontSize: 13.5, color: 'rgba(232,238,249,0.62)', lineHeight: 1.6 }}>{r.d}</Text>
                            </Box>
                        </Box>
                    ))}
                </Box>
            ))}
        </Box>
    </Box>

    {/* C 区 · 页脚 */}
    <Box style={{ height: 40, flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: 'rgba(232,238,249,0.42)' }}>从 LLM 到 Agent 再到 Pi Agent</Text>
        <Text style={{ fontSize: 14, color: 'rgba(232,238,249,0.42)', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>17 / 37</Text>
    </Box>
</Slide>
