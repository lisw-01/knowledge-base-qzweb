<Slide style={{ width: 1280, height: 720, padding: '20px 72px', flexDirection: 'column', background: 'linear-gradient(160deg, #0B1220 0%, #16233D 100%)', fontFamily: '"Source Han Sans SC", "Noto Sans SC", "Microsoft YaHei", sans-serif' }}>
    {/* A 区 · 标题块 */}
    <Box style={{ height: 100, flexDirection: 'row', gap: 16, alignItems: 'flex-start', paddingTop: 6 }}>
        <Box style={{ width: 4, height: 36, background: '#2AD4EE', marginTop: 5 }} />
        <Box style={{ flexDirection: 'column' }}>
            <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#E8EEF9' }}>九个设计点：对应七层地图</Text>
            <Text style={{ marginTop: 8, fontSize: 17, color: 'rgba(232,238,249,0.52)' }}>九个设计点都能落回那七层——接下来三页，逐个拆开看</Text>
        </Box>
    </Box>

    {/* B 区 · 左标题 + 右映射表 */}
    <Box style={{ height: 516, flexDirection: 'row', gap: 30 }}>
        {/* 左：标题栏 */}
        <Box style={{ width: 266, flexDirection: 'column', paddingRight: 26, borderRight: '1px solid rgba(232,238,249,0.12)' }}>
            <Text style={{ fontSize: 15, color: '#2AD4EE', letterSpacing: 3, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>DESIGN NOTES</Text>
            <Text style={{ marginTop: 16, fontSize: 26, fontWeight: 'bold', color: '#E8EEF9', lineHeight: 1.45 }}>
                九个设计点
                <br />
                一张映射表
            </Text>
            <Text style={{ marginTop: 16, fontSize: 16, color: 'rgba(232,238,249,0.72)', lineHeight: 1.8 }}>
                学完 Pi 的九个设计点，回头看七层地图，会发现它们一一对得上。
            </Text>

            <Box style={{ marginTop: 18, height: 96, flexDirection: 'column', alignItems: 'center', justifyContent: 'center', background: 'rgba(22,35,61,0.92)', border: '1px solid rgba(42,212,238,0.28)', borderRadius: 4 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14 }}>
                    <Text style={{ fontSize: 46, fontWeight: 'bold', color: '#2AD4EE', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace', lineHeight: 1 }}>9</Text>
                    <Text style={{ fontSize: 24, color: 'rgba(232,238,249,0.40)' }}>→</Text>
                    <Text style={{ fontSize: 46, fontWeight: 'bold', color: '#E8EEF9', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace', lineHeight: 1 }}>7</Text>
                </Box>
                <Text style={{ marginTop: 10, fontSize: 14, color: 'rgba(232,238,249,0.58)' }}>9 个设计点 · 7 个功能层 · 顺序一致</Text>
            </Box>

            <Box style={{ marginTop: 'auto', paddingTop: 14, paddingBottom: 14, paddingLeft: 16, paddingRight: 16, background: 'rgba(42,212,238,0.08)', border: '1px solid rgba(42,212,238,0.22)', borderRadius: 4 }}>
                <Text style={{ fontSize: 14, color: '#2AD4EE', letterSpacing: 3, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>所以</Text>
                <Text style={{ marginTop: 8, fontSize: 15, color: '#E8EEF9', lineHeight: 1.7 }}>
                    编号 1–7 就是层号 ①–⑦。这不是巧合，是刻意的教学设计。
                </Text>
            </Box>
        </Box>

        {/* 右：映射表 */}
        <Box style={{ flex: 1, flexDirection: 'column' }}>
            <Box style={{ flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingBottom: 10, borderBottom: '1px solid rgba(232,238,249,0.12)' }}>
                <Text style={{ fontSize: 14, color: 'rgba(232,238,249,0.42)', letterSpacing: 2, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>设计点 / 解决什么问题 / 对应功能层</Text>
                <Text style={{ fontSize: 13, color: 'rgba(232,238,249,0.42)' }}>每一个设计点，都解决一类具体问题</Text>
            </Box>

            <Box style={{ flex: 1, flexDirection: 'column', justifyContent: 'space-between' }}>
                {[
                    ['1', '模型适配', '一套统一类型 + 归一化流式事件：把厂商差异挡在循环之外，换模型不改业务代码', '① 模型层'],
                    ['2', '上下文工程', '常驻最小化：系统提示 <1000 token + 4 个工具，其余按需注入，放不下就 compaction', '② 提示层'],
                    ['3', '工具系统', '四阶段流水线：Prepare 校验 → Execute 执行 → Finalize 改写 / 脱敏 → 截断保护', '③ 工具层'],
                    ['4', '会话系统', '会话原语与持久化：历史怎么存、怎么取、怎么续跑，都是可替换的存储后端', '④ 记忆层'],
                    ['5', 'Agent 循环', '约 418 行双层 while：内层跑工具调用、外层跑续跑，终止与最大轮次都有兜底', '⑤ 控制层'],
                    ['6', '扩展系统', '能力全部外置成扩展：加工具、加拦截、加校验，全都不动内核一行代码', '⑥ 护栏层'],
                    ['7', '事件系统', '事件总线贯穿全程：文本与思考增量实时回流，是可观测性的地基', '⑦ 运营层'],
                    ['8', '安全与可观测', '内核不做权限：权限、沙箱与审计交回给使用方，用扩展钩子自建拦截', '⑥ + ⑦'],
                    ['9', '远程会话栈', 'CBOR 远程会话：协议 / 客户端 / 服务端三层，可选，不影响核心四层', '独立叠加'],
                ].map((r, i) => (
                    <Box key={i} style={{ flex: 1, flexDirection: 'row', alignItems: 'center', borderBottom: i === 8 ? 'none' : '1px solid rgba(232,238,249,0.10)' }}>
                        <Text style={{ width: 30, fontSize: 14, color: '#2AD4EE', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>{r[0]}</Text>
                        <Text style={{ width: 128, fontSize: 16, fontWeight: 'bold', color: '#E8EEF9' }}>{r[1]}</Text>
                        <Box style={{ width: 1, height: 18, background: 'rgba(232,238,249,0.16)', marginRight: 16 }} />
                        <Text style={{ flex: 1, fontSize: 13.5, color: 'rgba(232,238,249,0.68)', lineHeight: 1.5 }}>{r[2]}</Text>
                        <Box style={{ paddingTop: 4, paddingBottom: 4, paddingLeft: 12, paddingRight: 12, background: 'rgba(42,212,238,0.10)', border: '1px solid rgba(42,212,238,0.30)', borderRadius: 3 }}>
                            <Text style={{ fontSize: 13, color: '#2AD4EE', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>{r[3]}</Text>
                        </Box>
                    </Box>
                ))}
            </Box>
        </Box>
    </Box>

    {/* C 区 · 页脚 */}
    <Box style={{ height: 40, flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: 'rgba(232,238,249,0.42)' }}>从 LLM 到 Agent 再到 Pi Agent</Text>
        <Text style={{ fontSize: 14, color: 'rgba(232,238,249,0.42)', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>25 / 37</Text>
    </Box>
</Slide>
