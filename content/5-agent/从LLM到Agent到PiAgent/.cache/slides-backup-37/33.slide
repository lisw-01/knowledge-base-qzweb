<Slide style={{ width: 1280, height: 720, padding: '20px 72px', flexDirection: 'column', background: 'linear-gradient(160deg, #0B1220 0%, #16233D 100%)', fontFamily: '"Source Han Sans SC", "Noto Sans SC", "Microsoft YaHei", sans-serif' }}>
    {/* A 区 · 标题块 */}
    <Box style={{ height: 100, flexDirection: 'row', gap: 16, alignItems: 'flex-start', paddingTop: 6 }}>
        <Box style={{ width: 4, height: 36, background: '#2AD4EE', marginTop: 5 }} />
        <Box style={{ flexDirection: 'column' }}>
            <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#E8EEF9' }}>发现式注册：加工具 = 丢一个文件</Text>
            <Text style={{ marginTop: 8, fontSize: 17, color: 'rgba(232,238,249,0.52)' }}>代码里零硬编码工具数组，能力全在磁盘上</Text>
        </Box>
    </Box>

    {/* B 区 · 左标题 + 右代码与目录树 */}
    <Box style={{ height: 516, flexDirection: 'row', gap: 32 }}>
        {/* 左：标题栏 */}
        <Box style={{ width: 274, flexDirection: 'column', paddingRight: 28, borderRight: '1px solid rgba(232,238,249,0.12)' }}>
            <Text style={{ fontSize: 15, color: '#2AD4EE', letterSpacing: 3, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>DISCOVERY</Text>
            <Text style={{ marginTop: 18, fontSize: 26, fontWeight: 'bold', color: '#E8EEF9', lineHeight: 1.45 }}>
                加一个工具
                <br />
                等于丢一个文件
            </Text>
            <Text style={{ marginTop: 18, fontSize: 16, color: 'rgba(232,238,249,0.72)', lineHeight: 1.8 }}>
                启动时，
                <span style={{ color: '#2AD4EE', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>DefaultResourceLoader</span>
                扫描 <span style={{ color: '#2AD4EE', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>.pi/extensions/*.ts</span>，每个文件自己注册自己的工具。
            </Text>

            <Box style={{ marginTop: 18, flexDirection: 'column', gap: 9 }}>
                {['新增工具不动主干代码', 'AGENTS.md / APPEND_SYSTEM.md 自动合并进系统提示', '删除能力 = 删掉那个文件'].map((t, i) => (
                    <Box key={i} style={{ flexDirection: 'row', gap: 10, alignItems: 'flex-start' }}>
                        <Box style={{ width: 5, height: 5, background: '#2AD4EE', marginTop: 7 }} />
                        <Text style={{ flex: 1, fontSize: 14.5, color: 'rgba(232,238,249,0.68)', lineHeight: 1.5 }}>{t}</Text>
                    </Box>
                ))}
            </Box>

            <Box style={{ marginTop: 'auto', paddingTop: 16, paddingBottom: 16, paddingLeft: 16, paddingRight: 16, background: 'rgba(42,212,238,0.08)', border: '1px solid rgba(42,212,238,0.22)', borderRadius: 4 }}>
                <Text style={{ fontSize: 14, color: '#2AD4EE', letterSpacing: 3, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>所以</Text>
                <Text style={{ marginTop: 10, fontSize: 15.5, color: '#E8EEF9', lineHeight: 1.7 }}>
                    新增能力不改主干代码，这就是低耦合的落地方式。
                </Text>
            </Box>
        </Box>

        {/* 右：目录树 + 代码 */}
        <Box style={{ flex: 1, flexDirection: 'row', gap: 20 }}>
            {/* 目录树 */}
            <Box style={{ width: 290, flexDirection: 'column' }}>
                <Text style={{ fontSize: 15, color: 'rgba(232,238,249,0.52)', letterSpacing: 2, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>server/.pi/</Text>
                <Box style={{ flex: 1, marginTop: 12, flexDirection: 'column', paddingTop: 14, paddingBottom: 14, paddingLeft: 14, paddingRight: 14, background: 'rgba(22,35,61,0.92)', border: '1px solid rgba(42,212,238,0.22)', borderRadius: 4 }}>
                    {[
                        ['├─ extensions/', null, true],
                        ['│   ├─ query-metric.ts', 'query_metric', false],
                        ['│   ├─ call-api.ts', 'call_business_api', false],
                        ['│   ├─ safe-sql.ts', 'run_safe_sql', false],
                        ['│   ├─ emit-table.ts', 'emit_table', false],
                        ['│   ├─ emit-chart.ts', 'emit_chart', false],
                        ['│   └─ emit-kpi.ts', 'emit_kpi', false],
                        ['├─ AGENTS.md', '→ 自动合并进系统提示', true],
                        ['└─ APPEND_SYSTEM.md', '→ 自动追加', true],
                    ].map((r, i) => (
                        <Box key={i} style={{ flex: 1, flexDirection: 'column', justifyContent: 'center' }}>
                            <Text style={{ fontSize: 13, color: r[2] ? '#E8EEF9' : 'rgba(232,238,249,0.78)', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace', fontWeight: r[2] ? 'bold' : 'normal' }}>{r[0]}</Text>
                            {r[1] && <Text style={{ marginTop: 3, fontSize: 11.5, color: 'rgba(42,212,238,0.72)', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>{r[1]}</Text>}
                        </Box>
                    ))}
                </Box>
            </Box>

            {/* 代码 */}
            <Box style={{ flex: 1, flexDirection: 'column' }}>
                <Text style={{ fontSize: 15, color: 'rgba(232,238,249,0.52)', letterSpacing: 2, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>extensions/emit-table.ts</Text>
                <Box style={{ flex: 1, marginTop: 12 }}>
                    <CodeBlock
                        code={`import { defineTool, type ExtensionAPI } from
  "@earendil-works/pi-coding-agent";
import { Type } from "@sinclair/typebox";

const tool = defineTool({
  name: "emit_table",
  description: "向用户输出明细表格。",
  parameters: Type.Object({
    title: Type.Optional(Type.String()),
    rows: Type.Array(Type.Record(Type.String(), Type.Unknown())),
    source: Type.String(),
  }),
  async execute(_id, p) {
    return { details: { renderer: "table", data: p, source: p.source } };
  },
});

export default function (pi: ExtensionAPI) {
  pi.registerTool(tool);  // 文件即工具，无需集中注册表
}`}
                        language='typescript'
                        width={488}
                        fontSize={12.5}
                        theme='github-dark'
                    />
                </Box>
            </Box>
        </Box>
    </Box>

    {/* C 区 · 页脚 */}
    <Box style={{ height: 40, flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: 'rgba(232,238,249,0.42)' }}>从 LLM 到 Agent 再到 Pi Agent</Text>
        <Text style={{ fontSize: 14, color: 'rgba(232,238,249,0.42)', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>33 / 37</Text>
    </Box>
</Slide>
