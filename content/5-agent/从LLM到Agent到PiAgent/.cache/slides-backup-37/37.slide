<Slide style={{ width: 1280, height: 720, position: 'relative', overflow: 'hidden', background: '#0B1220', fontFamily: '"Source Han Sans SC", "Noto Sans SC", "Microsoft YaHei", sans-serif' }}>
    <Image src="assets/ending_hero.png" style={{ position: 'absolute', left: 0, top: 0, width: 1536, height: 1024 }} />
    <Box style={{ position: 'absolute', left: 0, top: 0, width: 1280, height: 720, background: 'linear-gradient(180deg, rgba(11,18,32,0.93) 0%, rgba(11,18,32,0.74) 26%, rgba(11,18,32,0.52) 52%, rgba(11,18,32,0.94) 100%)' }} />
    <Box style={{ position: 'absolute', left: 0, top: 0, width: 1280, height: 720, background: 'linear-gradient(90deg, rgba(11,18,32,0.80) 0%, rgba(11,18,32,0.10) 50%, rgba(11,18,32,0.80) 100%)' }} />

    {/* 内容 */}
    <Box style={{ position: 'absolute', left: 120, top: 104, width: 1040, height: 512, flexDirection: 'column', alignItems: 'center', justifyContent: 'space-between' }}>
        {/* 金句 */}
        <Box style={{ flexDirection: 'column', alignItems: 'center' }}>
            <Text style={{ fontSize: 16, color: '#2AD4EE', letterSpacing: 8, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>ENDING</Text>
            <Text style={{ marginTop: 24, fontSize: 62, fontWeight: 'bold', color: '#E8EEF9', textAlign: 'center', lineHeight: 1.25, letterSpacing: 1 }}>
                模型是原料，
                <span style={{ color: '#2AD4EE' }}>工程才是产品</span>。
            </Text>
            <Box style={{ marginTop: 22, width: 96, height: 4, background: '#2AD4EE' }} />
        </Box>

        {/* 三段回顾 */}
        <Box style={{ width: 1040, flexDirection: 'row' }}>
            {[
                { k: 'MODEL', t: '模型', d: '无状态、有窗口。它决定「下一步干什么」，但什么都不记得。' },
                { k: 'ENGINEERING', t: '工程', d: '七层功能地图 + 十条设计原则。边界，比能力更重要。' },
                { k: 'DELIVERY', t: '落地', d: '三级路由 + 发现式注册，把知识装进一个真实业务系统。' },
            ].map((c, i) => (
                <Box key={i} style={{ flex: 1, flexDirection: 'column', alignItems: 'center', paddingLeft: 24, paddingRight: 24, borderRight: i === 2 ? 'none' : '1px solid rgba(232,238,249,0.16)' }}>
                    <Text style={{ fontSize: 12, color: 'rgba(42,212,238,0.85)', letterSpacing: 3, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>{c.k}</Text>
                    <Text style={{ marginTop: 12, fontSize: 22, fontWeight: 'bold', color: '#E8EEF9' }}>{c.t}</Text>
                    <Text style={{ marginTop: 10, fontSize: 14.5, color: 'rgba(232,238,249,0.72)', textAlign: 'center', lineHeight: 1.7 }}>{c.d}</Text>
                </Box>
            ))}
        </Box>

        {/* 落款 */}
        <Box style={{ flexDirection: 'column', alignItems: 'center' }}>
            <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#E8EEF9', letterSpacing: 2 }}>谢谢 · 欢迎提问</Text>
            <Text style={{ marginTop: 14, fontSize: 14, color: 'rgba(232,238,249,0.48)', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>从 LLM 到 Agent 再到 Pi Agent　·　37 / 37</Text>
        </Box>
    </Box>
</Slide>
