<Slide style={{ width: 1280, height: 720, padding: '20px 72px', flexDirection: 'column', background: 'linear-gradient(160deg, #0B1220 0%, #16233D 100%)', fontFamily: '"Source Han Sans SC", "Noto Sans SC", "Microsoft YaHei", sans-serif' }}>
    {/* A 区 · 标题块 */}
    <Box style={{ height: 100, flexDirection: 'row', gap: 16, alignItems: 'flex-start', paddingTop: 6 }}>
        <Box style={{ width: 4, height: 36, background: '#2AD4EE', marginTop: 5 }} />
        <Box style={{ flexDirection: 'column' }}>
            <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#E8EEF9' }}>目录</Text>
            <Text style={{ marginTop: 8, fontSize: 17, color: 'rgba(232,238,249,0.52)' }}>四章 · 37 页 · 一条从模型到业务系统的完整链路</Text>
        </Box>
    </Box>

    {/* B 区 · 左窄标题栏 + 右内容 */}
    <Box style={{ height: 516, flexDirection: 'row', gap: 40 }}>
        {/* 左：巨型数字 */}
        <Box style={{ width: 268, flexDirection: 'column', justifyContent: 'center', paddingRight: 24, borderRight: '1px solid rgba(232,238,249,0.12)' }}>
            <Text style={{ fontSize: 96, fontWeight: 'bold', color: '#2AD4EE', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace', lineHeight: 1 }}>04</Text>
            <Text style={{ marginTop: 14, fontSize: 15, color: 'rgba(232,238,249,0.52)', letterSpacing: 2, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>CHAPTERS</Text>
            <Box style={{ marginTop: 22, width: 40, height: 2, background: '#2AD4EE' }} />
            <Text style={{ marginTop: 22, fontSize: 17, color: 'rgba(232,238,249,0.70)', lineHeight: 1.75 }}>
                先补认知，再建工程观；
                <br />
                然后看一个范本，
                <br />
                最后落进一个真实系统。
            </Text>
        </Box>

        {/* 右：四章条目 */}
        <Box style={{ flexDirection: 'column', flex: 1 }}>
            {[
                { n: '01', t: 'LLM：一切的地基', d: '看懂 LLM 的无状态本质，理解 Agent 为什么必须做上下文工程。', p: '03–10', k: ['Token', '上下文窗口', 'Function Calling'] },
                { n: '02', t: 'Agent：从“能聊”到“能干”', d: '掌握 ReAct 与七层功能地图，说清 Agent 的能力边界到底在哪。', p: '11–19', k: ['ReAct', '七层地图', '十条原则'] },
                { n: '03', t: 'Pi Agent：一个极简范式', d: '理解极简哲学与严格单向的分层架构，看懂它的每一个设计取舍。', p: '20–38', k: ['418 行内核', '四层架构', '三层定制'] },
                { n: '04', t: '落地实践：智数问答 agent-DQ', d: '完整拆解一个真实业务系统，带走可直接复用的踩坑经验。', p: '39–45', k: ['三级路由', '发现式注册', '流式渲染'] },
            ].map((c, i) => (
                <Box key={i} style={{ flex: 1, flexDirection: 'column', justifyContent: 'center', borderBottom: i === 3 ? 'none' : '1px solid rgba(232,238,249,0.12)' }}>
                    <Box style={{ flexDirection: 'row', alignItems: 'flex-start', gap: 22 }}>
                        <Text style={{ fontSize: 22, color: '#2AD4EE', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace', width: 44, marginTop: 4 }}>{c.n}</Text>
                        <Box style={{ flexDirection: 'column', flex: 1 }}>
                            <Text style={{ fontSize: 24, fontWeight: '600', color: '#E8EEF9' }}>{c.t}</Text>
                            <Text style={{ marginTop: 6, fontSize: 17, color: 'rgba(232,238,249,0.62)', lineHeight: 1.5 }}>{c.d}</Text>
                        </Box>
                        <Text style={{ fontSize: 15, color: 'rgba(232,238,249,0.42)', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace', marginTop: 6 }}>{c.p}</Text>
                    </Box>
                    <Box style={{ flexDirection: 'row', gap: 8, marginTop: 12, marginLeft: 66 }}>
                        {c.k.map((k, j) => (
                            <Box key={j} style={{ paddingTop: 4, paddingBottom: 4, paddingLeft: 10, paddingRight: 10, background: 'rgba(42,212,238,0.10)', borderRadius: 3 }}>
                                <Text style={{ fontSize: 14, color: '#2AD4EE' }}>{k}</Text>
                            </Box>
                        ))}
                    </Box>
                </Box>
            ))}
        </Box>
    </Box>

    {/* C 区 · 页脚 */}
    <Box style={{ height: 40, flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: 'rgba(232,238,249,0.42)' }}>从 LLM 到 Agent 再到 Pi Agent</Text>
        <Text style={{ fontSize: 14, color: 'rgba(232,238,249,0.42)', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>02 / 46</Text>
    </Box>
</Slide>
