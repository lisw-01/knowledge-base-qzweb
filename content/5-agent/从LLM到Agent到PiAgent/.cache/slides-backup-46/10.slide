<Slide style={{ width: 1280, height: 720, padding: '20px 72px', flexDirection: 'column', background: 'linear-gradient(160deg, #0B1220 0%, #16233D 100%)', fontFamily: '"Source Han Sans SC", "Noto Sans SC", "Microsoft YaHei", sans-serif' }}>
    {/* A 区 · 标题块 */}
    <Box style={{ height: 100, flexDirection: 'row', gap: 16, alignItems: 'flex-start', paddingTop: 6 }}>
        <Box style={{ width: 4, height: 36, background: '#2AD4EE', marginTop: 5 }} />
        <Box style={{ flexDirection: 'column' }}>
            <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#E8EEF9' }}>A/B 对比与一条安全红线</Text>
            <Text style={{ marginTop: 8, fontSize: 17, color: 'rgba(232,238,249,0.52)' }}>五个维度看差别，一条原则定生死</Text>
        </Box>
    </Box>

    {/* B 区 · 表格 + 洞察 */}
    <Box style={{ height: 516, flexDirection: 'column' }}>
        <Box style={{ height: 340, flexDirection: 'column' }}>
            <Table
                style={{ width: '100%', height: '100%' }}
                defaultTextStyle={{ fontSize: 17, textAlign: 'left', color: '#E8EEF9' }}
                defaultCellStyle={{
                    border: {
                        bottom: { width: 1, color: 'rgba(232,238,249,0.12)' },
                    },
                }}
                cells={[
                    [
                        { text: '维度', textStyle: { bold: true, color: '#2AD4EE', fontSize: 17 }, cellStyle: { background: { color: '#16233D' } } },
                        { text: '方案 A · 手写 Prompt', textStyle: { bold: true, color: 'rgba(232,238,249,0.70)', fontSize: 17 }, cellStyle: { background: { color: '#16233D' } } },
                        { text: '方案 B · 原生 Function Calling', textStyle: { bold: true, color: '#2AD4EE', fontSize: 17 }, cellStyle: { background: { color: '#16233D' } } },
                    ],
                    ['格式约定', '自己发明（Action:工具名[参数]）', '官方标准（JSON Schema）'],
                    ['模型输出', '普通文本，要正则抠参数', '结构化 tool_calls JSON，直接解析'],
                    ['稳定性', '模型可能不守格式，需各种兜底', '模型专门训练过，非常稳'],
                    ['兼容性', '任何模型都能用（哪怕不支持 FC）', '需要模型支持（GLM-4 / GPT 等）'],
                    [
                        '使用建议',
                        '理解原理用',
                        { text: '实际项目一律用这个', textStyle: { bold: true, color: '#2AD4EE' } },
                    ],
                ]}
            />
        </Box>

        {/* 洞察 */}
        <Box style={{ height: 162, marginTop: 14, flexDirection: 'row', gap: 20 }}>
            <Box style={{ flex: 1, flexDirection: 'column', paddingTop: 16, paddingBottom: 16, paddingLeft: 20, paddingRight: 20, background: 'rgba(22,35,61,0.95)', border: '1px solid rgba(42,212,238,0.35)', borderRadius: 4 }}>
                <Text style={{ fontSize: 15, color: '#2AD4EE', letterSpacing: 2, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>选型结论</Text>
                <Text style={{ marginTop: 12, fontSize: 17, color: '#E8EEF9', lineHeight: 1.65 }}>
                    能用原生 Function Calling 就不用自己发明格式。手写 Prompt 的价值在于让你看清循环内部长什么样——理解原理，而不是交付方案。
                </Text>
            </Box>
            <Box style={{ flex: 1, flexDirection: 'column', paddingTop: 16, paddingBottom: 16, paddingLeft: 20, paddingRight: 20, background: 'rgba(42,212,238,0.10)', border: '1px solid rgba(42,212,238,0.35)', borderRadius: 4 }}>
                <Text style={{ fontSize: 15, color: '#2AD4EE', letterSpacing: 2, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>安全红线</Text>
                <Text style={{ marginTop: 12, fontSize: 17, color: '#E8EEF9', lineHeight: 1.65 }}>
                    两种方案里，模型都只负责「说要调什么」，真正执行函数的永远是我们的代码——<span style={{ color: '#2AD4EE' }}>模型没有权限，只有建议权</span>。
                </Text>
            </Box>
        </Box>
    </Box>

    {/* C 区 · 页脚 */}
    <Box style={{ height: 40, flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: 'rgba(232,238,249,0.42)' }}>从 LLM 到 Agent 再到 Pi Agent</Text>
        <Text style={{ fontSize: 14, color: 'rgba(232,238,249,0.42)', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>10 / 46</Text>
    </Box>
</Slide>
