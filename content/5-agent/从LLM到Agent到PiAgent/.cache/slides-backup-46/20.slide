    <Box style={{ position: 'absolute', left: 0, top: 0, width: 1040, height: 720, background: 'linear-gradient(90deg, rgba(11,18,32,0.97) 0%, rgba(11,18,32,0.84) 50%, rgba(11,18,32,0) 100%)' }} />
    <Box style={{ position: 'absolute', left: 0, top: 0, width: 6, height: 720, background: 'linear-gradient(180deg, #2AD4EE 0%, rgba(42,212,238,0) 100%)' }} />

    {/* 左：整列分布 */}
    <Box style={{ position: 'absolute', left: 88, top: 152, width: 700, height: 508, flexDirection: 'column', justifyContent: 'space-between' }}>
        <Box style={{ flexDirection: 'column' }}>
            <Text style={{ fontSize: 18, color: '#2AD4EE', letterSpacing: 7, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>CHAPTER 03</Text>
            <Text style={{ marginTop: 22, fontSize: 64, fontWeight: 'bold', color: '#E8EEF9', letterSpacing: 1, lineHeight: 1.2 }}>
                Pi Agent：
                <br />
                <span style={{ color: '#2AD4EE' }}>一个极简范式</span>
            </Text>
        </Box>

        <Box style={{ flexDirection: 'column' }}>
            <Box style={{ width: 76, height: 4, background: '#2AD4EE' }} />
            <Text style={{ marginTop: 24, fontSize: 21, color: 'rgba(232,238,249,0.72)', lineHeight: 1.75 }}>
                自主智能体本质就是 LLM + 工具 + 循环；
                <br />
                Pi 把这条公式工程化到了极致。
            </Text>
        </Box>

        <Box style={{ flexDirection: 'column' }}>
            <Box style={{ width: 420, height: 1, background: 'rgba(232,238,249,0.18)' }} />
            <Text style={{ marginTop: 16, fontSize: 13, color: 'rgba(232,238,249,0.42)', letterSpacing: 3, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>本章要回答</Text>
            <Box style={{ marginTop: 12, flexDirection: 'column', gap: 8 }}>
