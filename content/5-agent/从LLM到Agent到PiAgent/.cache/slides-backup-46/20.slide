    {/* 右：章节号 + 目录 */}
    <Box style={{ position: 'absolute', right: 88, top: 336, width: 392, flexDirection: 'column', paddingTop: 22, paddingBottom: 22, paddingLeft: 24, paddingRight: 24, background: 'rgba(11,18,32,0.82)', border: '1px solid rgba(42,212,238,0.22)', borderRadius: 4 }}>
        <Box style={{ flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between' }}>
            <Text style={{ fontSize: 76, fontWeight: 'bold', color: 'rgba(42,212,238,0.55)', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace', lineHeight: 1 }}>03</Text>
            <Text style={{ fontSize: 13, color: 'rgba(232,238,249,0.42)', letterSpacing: 3, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace', paddingBottom: 8 }}>PAGES 20 – 38</Text>
