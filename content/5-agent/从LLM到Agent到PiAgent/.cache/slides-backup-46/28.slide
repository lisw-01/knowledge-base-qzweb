<Slide style={{ width: 1280, height: 720, padding: '20px 72px', flexDirection: 'column', background: 'linear-gradient(160deg, #0B1220 0%, #16233D 100%)', fontFamily: '"Source Han Sans SC", "Noto Sans SC", "Microsoft YaHei", sans-serif' }}>
    {/* A 区 */}
    <Box style={{ height: 100, flexDirection: 'row', gap: 16, alignItems: 'flex-start', paddingTop: 6 }}>
        <Box style={{ width: 4, height: 36, background: '#2AD4EE', marginTop: 5 }} />
        <Box style={{ flexDirection: 'column' }}>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
                <Text style={{ fontSize: 13, color: '#2AD4EE', letterSpacing: 3, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>DESIGN POINT 02</Text>
                <Text style={{ fontSize: 13, color: 'rgba(232,238,249,0.38)', letterSpacing: 2, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>· 对应 ② 提示层</Text>
            </Box>
            <Text style={{ marginTop: 6, fontSize: 34, fontWeight: 'bold', color: '#E8EEF9' }}>上下文工程：每一行常驻都要付租金</Text>
        </Box>
    </Box>

    {/* B 区 */}
    <Box style={{ height: 516, flexDirection: 'column' }}>
        <Box style={{ height: 452, flexDirection: 'row', gap: 30 }}>

            {/* 左：五层堆栈 */}
            <Box style={{ width: 596, flexDirection: 'column' }}>
                <Box style={{ flexDirection: 'row', alignItems: 'baseline', justifyContent: 'space-between' }}>
                    <Text style={{ fontSize: 14, color: '#2AD4EE', letterSpacing: 2.5, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>SYSTEM PROMPT · 分层组装</Text>
                    <Text style={{ fontSize: 12.5, color: 'rgba(232,238,249,0.42)' }}>越靠上越稳定</Text>
                </Box>

                <Box style={{ marginTop: 10, flexDirection: 'column', gap: 5 }}>
                    {[
                        ['基础系统提示', '编码代理人格 + guidelines + 工具片段', '内核生成 · <1000 token', 'rgba(42,212,238,0.16)', '100%'],
                        ['AGENTS.md', '项目规则，从 cwd 向上逐级遍历自动发现', '跟着仓库走 · 随 git 版本化', 'rgba(42,212,238,0.11)', '100%'],
                        ['SYSTEM.md', '稳定的行为边界', '长期不变', 'rgba(42,212,238,0.08)', '96%'],
                        ['APPEND_SYSTEM.md', '追加指令，~/.pi/agent 或 .pi', '环境级差异', 'rgba(42,212,238,0.06)', '92%'],
                        ['Skills 目录', '只有 name + description 常驻，正文按需加载', '目录常驻 · 正文不常驻', 'rgba(232,238,249,0.04)', '88%'],
                    ].map((r, i) => (
                        <Box key={i} style={{ width: r[4], height: 60, flexDirection: 'row', alignItems: 'center', paddingLeft: 14, paddingRight: 14, background: r[3], border: '1px solid rgba(42,212,238,0.16)', borderRadius: 3 }}>
                            <Text style={{ width: 156, fontSize: 14.5, fontWeight: 'bold', color: '#E8EEF9' }}>{r[0]}</Text>
                            <Text style={{ flex: 1, fontSize: 12.5, color: 'rgba(232,238,249,0.62)', lineHeight: 1.45 }}>{r[1]}</Text>
                            <Text style={{ width: 150, fontSize: 11.5, color: '#2AD4EE', textAlign: 'right', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>{r[2]}</Text>
                        </Box>
                    ))}
                </Box>

                <Text style={{ marginTop: 10, fontSize: 12, color: 'rgba(232,238,249,0.46)' }}>SDK 层可覆盖：systemPromptOverride / appendSystemPromptOverride / agentsFilesOverride</Text>

                <Box style={{ marginTop: 'auto', paddingTop: 10, paddingBottom: 10, paddingLeft: 14, paddingRight: 14, borderLeft: '3px solid #2AD4EE', background: 'rgba(42,212,238,0.06)' }}>
                    <Text style={{ fontSize: 13, color: '#E8EEF9', lineHeight: 1.55 }}>
                        进系统提示的每一行，都要付「每轮都发」的租金——所以常驻最小化，其余按需注入。
                    </Text>
                </Box>
            </Box>

            {/* 右：两卡 */}
            <Box style={{ flex: 1, flexDirection: 'column', gap: 14 }}>
                <Box style={{ flex: 1.25, flexDirection: 'column', paddingTop: 16, paddingBottom: 14, paddingLeft: 18, paddingRight: 18, background: 'rgba(22,35,61,0.72)', border: '1px solid rgba(42,212,238,0.20)', borderRadius: 4 }}>
                    <Text style={{ fontSize: 13, color: '#2AD4EE', letterSpacing: 2, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>SKILLS</Text>
                    <Text style={{ marginTop: 8, fontSize: 17, fontWeight: 'bold', color: '#E8EEF9' }}>目录常驻，正文按需</Text>
                    <Text style={{ marginTop: 8, fontSize: 13, color: 'rgba(232,238,249,0.74)', lineHeight: 1.65 }}>
                        <span style={{ color: '#2AD4EE', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>.pi/skills/&lt;name&gt;/SKILL.md</span>
                        ，frontmatter 写 name + description。模型只看到目录，需要时才读正文。
                    </Text>
                    <Box style={{ marginTop: 10, flexDirection: 'column', gap: 6 }}>
                        {[
                            ['和 RAG 同源', '检索式注入，优于全量携带'],
                            ['disableModelInvocation', '只许用户手动触发，不许模型自己调'],
                            ['可筛选/合并/内联', 'skillsOverride + 合成 sourceInfo'],
                        ].map((r, i) => (
                            <Box key={i} style={{ flexDirection: 'row', gap: 8, alignItems: 'flex-start' }}>
                                <Box style={{ width: 4, height: 4, background: '#2AD4EE', marginTop: 7 }} />
                                <Text style={{ flex: 1, fontSize: 12.5, color: 'rgba(232,238,249,0.62)', lineHeight: 1.55 }}>
                                    <span style={{ color: '#E8EEF9' }}>{r[0]}</span> · {r[1]}
                                </Text>
                            </Box>
                        ))}
                    </Box>
                </Box>

                <Box style={{ flex: 1, flexDirection: 'column', paddingTop: 16, paddingBottom: 14, paddingLeft: 18, paddingRight: 18, background: 'rgba(22,35,61,0.72)', border: '1px solid rgba(232,238,249,0.10)', borderRadius: 4 }}>
                    <Text style={{ fontSize: 13, color: '#2AD4EE', letterSpacing: 2, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>PROMPT 模板</Text>
                    <Text style={{ marginTop: 8, fontSize: 17, fontWeight: 'bold', color: '#E8EEF9' }}>文件版斜杠命令</Text>
                    <Text style={{ marginTop: 8, fontSize: 13, color: 'rgba(232,238,249,0.74)', lineHeight: 1.65 }}>
                        <span style={{ color: '#2AD4EE', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>/templatename</span>
                        触发，模板是 markdown 文件，内容作为 prompt 注入。部署步骤、审查清单这类固定流程，沉淀成模板比每次口述可靠。
                    </Text>
                </Box>
            </Box>
        </Box>

        {/* 底部通栏：1/3 从哪来 */}
        <Box style={{ height: 52, flexDirection: 'row', alignItems: 'center', gap: 16, paddingLeft: 18, paddingRight: 18, background: 'rgba(42,212,238,0.08)', border: '1px solid rgba(42,212,238,0.22)', borderRadius: 4 }}>
            <Text style={{ fontSize: 13, color: '#2AD4EE', letterSpacing: 2, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace', lineHeight: 1.4 }}>1/3<br />从哪来</Text>
            <Text style={{ flex: 1, fontSize: 14, color: '#E8EEF9', lineHeight: 1.55 }}>
                系统提示 &lt;1000 token · 默认只挂 4 个工具 · Skills 按需不常驻 · compaction 主动压长会话 —— 四件事叠加，才有 Databricks 基准里约三分之一的每轮上下文。
            </Text>
        </Box>
    </Box>

    {/* C 区 */}
    <Box style={{ height: 40, flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: 'rgba(232,238,249,0.42)' }}>从 LLM 到 Agent 再到 Pi Agent</Text>
        <Text style={{ fontSize: 14, color: 'rgba(232,238,249,0.42)', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>28 / 46</Text>
    </Box>
</Slide>
