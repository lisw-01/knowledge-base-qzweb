<Slide style={{ width: 1280, height: 720, padding: '20px 72px', flexDirection: 'column', background: 'linear-gradient(160deg, #0B1220 0%, #16233D 100%)', fontFamily: '"Source Han Sans SC", "Noto Sans SC", "Microsoft YaHei", sans-serif' }}>
    {/* A 区 */}
    <Box style={{ height: 100, flexDirection: 'row', gap: 16, alignItems: 'flex-start', paddingTop: 6 }}>
        <Box style={{ width: 4, height: 36, background: '#2AD4EE', marginTop: 5 }} />
        <Box style={{ flexDirection: 'column' }}>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
                <Text style={{ fontSize: 13, color: '#2AD4EE', letterSpacing: 3, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>DESIGN POINT 09</Text>
                <Text style={{ fontSize: 13, color: 'rgba(232,238,249,0.38)', letterSpacing: 2, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>· 七层之外 · 可选</Text>
            </Box>
            <Text style={{ marginTop: 6, fontSize: 34, fontWeight: 'bold', color: '#E8EEF9' }}>远程会话栈：同一套 Agent，换个壳</Text>
        </Box>
    </Box>

    {/* B 区 */}
    <Box style={{ height: 516, flexDirection: 'column' }}>
        <Box style={{ height: 452, flexDirection: 'row', gap: 28 }}>

            {/* 左：协议 */}
            <Box style={{ width: 646, flexDirection: 'column' }}>
                <Text style={{ fontSize: 14, color: '#2AD4EE', letterSpacing: 2.5, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>PROTOCOL · 三个包</Text>

                <Box style={{ marginTop: 9, flexDirection: 'column', gap: 6 }}>
                    {[
                        ['pi-protocol', 'CBOR schema（typebox 定义）+ framing + codec：只做字节 ↔ 消息，不含任何业务逻辑'],
                        ['pi-client', '传输无关客户端；ByteTransport 是任意传输的插入点（send/close + onData/onClose/onError）'],
                        ['pi-server', '接入字节连接、帧解码、sessionId 多路分发、命令调度'],
                    ].map((r, i) => (
                        <Box key={i} style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start', paddingTop: 7, paddingBottom: 7, borderTop: i === 0 ? 'none' : '1px solid rgba(232,238,249,0.07)' }}>
                            <Text style={{ width: 112, fontSize: 12, color: '#2AD4EE', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>{r[0]}</Text>
                            <Text style={{ flex: 1, fontSize: 12, color: 'rgba(232,238,249,0.68)', lineHeight: 1.55 }}>{r[1]}</Text>
                        </Box>
                    ))}
                </Box>

                <Text style={{ marginTop: 12, fontSize: 13, color: 'rgba(232,238,249,0.46)' }}>线格式与握手</Text>
                <CodeBlock
                    code={`frame  :=  uint32_be(len) + cbor(payload)     // 4-byte big-endian length prefix
frameDecoder: 任意分块进 -> 完整帧出（带最大帧长校验）

client -> { type: "hello", version }
server -> ServerHello { serverId, sessions, models, snapshot }
       |  hello_error
// CBOR: smaller than JSON; schema-validated in codec, not a raw WS message`}
                    language='typescript'
                    width={646}
                    fontSize={11.5}
                    theme='github-dark'
                />

                <Text style={{ marginTop: 10, fontSize: 13, color: 'rgba(232,238,249,0.46)' }}>协议条目：远端只理解协议，不理解内核类型</Text>
                <Box style={{ marginTop: 6, flexDirection: 'row', gap: 6, flexWrap: 'wrap' }}>
                    {['UserTranscriptItem', 'AssistantTranscriptItem', 'ToolTranscriptItem', 'item_started', 'assistant_delta', 'item_finished', 'SessionSnapshot', 'prompt / steer / abort'].map((t, i) => (
                        <Box key={i} style={{ paddingTop: 3, paddingBottom: 3, paddingLeft: 7, paddingRight: 7, background: 'rgba(42,212,238,0.07)', borderRadius: 2 }}>
                            <Text style={{ fontSize: 10, color: 'rgba(232,238,249,0.70)', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>{t}</Text>
                        </Box>
                    ))}
                </Box>
                <Text style={{ marginTop: 7, fontSize: 11.5, color: 'rgba(232,238,249,0.50)', lineHeight: 1.5 }}>
                    assistant 带 status：streaming / complete / error / aborted —— 远端 UI 靠 status 渲染，不靠猜。
                </Text>
            </Box>

            {/* 右：五层 + 租约 */}
            <Box style={{ flex: 1, flexDirection: 'column' }}>
                <Text style={{ fontSize: 14, color: '#2AD4EE', letterSpacing: 2.5, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>五层 · server 不重写循环</Text>

                <Box style={{ marginTop: 10, flexDirection: 'column', gap: 4 }}>
                    {[
                        ['L5', 'pi-client', '传输无关 CBOR 客户端', 'rgba(42,212,238,0.15)'],
                        ['L4', 'pi-server', '帧解码 · 多路分发 · 命令调度', 'rgba(42,212,238,0.11)'],
                        ['L3', 'pi-coding-agent', '产品运行时 · 扩展 · 工具 · 会话', 'rgba(42,212,238,0.08)'],
                        ['L2', 'pi-agent-core', '循环 · 事件 · 工具编排', 'rgba(42,212,238,0.06)'],
                        ['L1', 'pi-ai', '统一 LLM provider', 'rgba(232,238,249,0.04)'],
                    ].map((r, i) => (
                        <Box key={i} style={{ flexDirection: 'row', alignItems: 'center', gap: 10, paddingTop: 8, paddingBottom: 8, paddingLeft: 12, paddingRight: 12, background: r[3], border: '1px solid rgba(42,212,238,0.14)', borderRadius: 2 }}>
                            <Text style={{ width: 26, fontSize: 11, color: 'rgba(42,212,238,0.72)', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>{r[0]}</Text>
                            <Text style={{ width: 128, fontSize: 11.5, color: '#E8EEF9', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>{r[1]}</Text>
                            <Text style={{ flex: 1, fontSize: 11, color: 'rgba(232,238,249,0.56)' }}>{r[2]}</Text>
                        </Box>
                    ))}
                </Box>

                <Text style={{ marginTop: 10, fontSize: 11.5, color: 'rgba(232,238,249,0.52)', lineHeight: 1.55 }}>
                    远程只是换个壳：server 内部复用的还是 createAgentSession / AgentSession，行为和本地完全一致。
                </Text>

                <Box style={{ marginTop: 10, paddingTop: 10, paddingBottom: 10, paddingLeft: 12, paddingRight: 12, background: 'rgba(22,35,61,0.72)', border: '1px solid rgba(232,238,249,0.10)', borderRadius: 3 }}>
                    <Text style={{ fontSize: 12, color: '#2AD4EE', fontWeight: 'bold' }}>租约：多端不打架</Text>
                    <Text style={{ marginTop: 5, fontSize: 11.5, color: 'rgba(232,238,249,0.64)', lineHeight: 1.55 }}>
                        exclusive 独占（创建者持有）/ shared 共享附着；支持 generation 失效与清理 reconciliation。零连接 + 零操作 + idle 的会话会被自动 dispose。
                    </Text>
                </Box>

                <Box style={{ marginTop: 'auto', marginBottom: 6, paddingTop: 8 }}>
                    <Text style={{ fontSize: 11, color: 'rgba(255,180,120,0.72)', lineHeight: 1.5 }}>
                        注意：CBOR 栈只有字节流 transport，不原生支持 SSE。要接 HTTP，得自己做网关（POST 控制 + SSE 推帧）。
                    </Text>
                </Box>
            </Box>
        </Box>

        {/* 底部 */}
        <Box style={{ height: 52, marginTop: 8, flexDirection: 'row', alignItems: 'center', gap: 14, paddingLeft: 18, paddingRight: 18, background: 'rgba(42,212,238,0.08)', border: '1px solid rgba(42,212,238,0.22)', borderRadius: 4 }}>
            <Text style={{ fontSize: 13, color: '#2AD4EE', letterSpacing: 2, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>取舍</Text>
            <Text style={{ flex: 1, fontSize: 15, color: '#E8EEF9', lineHeight: 1.5 }}>
                只是本地进程间通信，stdio RPC（JSON 行协议）就够了。这套栈是为「跨进程、跨机器、多端附着」准备的。
            </Text>
        </Box>
    </Box>

    {/* C 区 */}
    <Box style={{ height: 40, flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: 'rgba(232,238,249,0.42)' }}>从 LLM 到 Agent 再到 Pi Agent</Text>
        <Text style={{ fontSize: 14, color: 'rgba(232,238,249,0.42)', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>37 / 46</Text>
    </Box>
</Slide>
