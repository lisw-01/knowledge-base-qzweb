<Slide style={{ width: 1280, height: 720, position: 'relative', overflow: 'hidden', background: '#0B1220', fontFamily: '"Source Han Sans SC", "Noto Sans SC", "Microsoft YaHei", sans-serif' }}>
    <Image src="assets/sec_llm.png" style={{ position: 'absolute', left: 0, top: 0, width: 1536, height: 1024 }} />

    <Box style={{ position: 'absolute', left: 0, top: 0, width: 1040, height: 720, background: 'linear-gradient(90deg, rgba(11,18,32,0.97) 0%, rgba(11,18,32,0.84) 50%, rgba(11,18,32,0) 100%)' }} />
    <Box style={{ position: 'absolute', left: 0, top: 0, width: 6, height: 720, background: 'linear-gradient(180deg, #2AD4EE 0%, rgba(42,212,238,0) 100%)' }} />

    {/* 左：整列分布 */}
    <Box style={{ position: 'absolute', left: 88, top: 152, width: 700, height: 508, flexDirection: 'column', justifyContent: 'space-between' }}>
        <Box style={{ flexDirection: 'column' }}>
            <Text style={{ fontSize: 18, color: '#2AD4EE', letterSpacing: 7, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>CHAPTER 01</Text>
            <Text style={{ marginTop: 22, fontSize: 64, fontWeight: 'bold', color: '#E8EEF9', letterSpacing: 1, lineHeight: 1.2 }}>
                LLM：
                <br />
                <span style={{ color: '#2AD4EE' }}>一切的地基</span>
            </Text>
        </Box>

        <Box style={{ flexDirection: 'column' }}>
            <Box style={{ width: 76, height: 4, background: '#2AD4EE' }} />
            <Text style={{ marginTop: 24, fontSize: 21, color: 'rgba(232,238,249,0.72)', lineHeight: 1.75 }}>
                不认识 LLM 的「无状态」，
                <br />
                就理解不了 Agent 的上下文工程。
            </Text>
        </Box>

        <Box style={{ flexDirection: 'column' }}>
            <Box style={{ width: 420, height: 1, background: 'rgba(232,238,249,0.18)' }} />
            <Text style={{ marginTop: 16, fontSize: 13, color: 'rgba(232,238,249,0.42)', letterSpacing: 3, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>本章要回答</Text>
            <Box style={{ marginTop: 12, flexDirection: 'column', gap: 8 }}>
                {['LLM 每次请求到底记住了什么？', '为什么必须用工具调用？', '手写 Prompt 与原生 FC 差在哪？'].map((t, i) => (
                    <Box key={i} style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
                        <Box style={{ width: 5, height: 5, background: '#2AD4EE' }} />
                        <Text style={{ fontSize: 17, color: 'rgba(232,238,249,0.78)' }}>{t}</Text>
                    </Box>
                ))}
            </Box>
        </Box>
    </Box>

    {/* 右：章节号 + 目录 */}
    <Box style={{ position: 'absolute', right: 88, top: 336, width: 392, flexDirection: 'column', paddingTop: 22, paddingBottom: 22, paddingLeft: 24, paddingRight: 24, background: 'rgba(11,18,32,0.82)', border: '1px solid rgba(42,212,238,0.22)', borderRadius: 4 }}>
        <Box style={{ flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between' }}>
            <Text style={{ fontSize: 76, fontWeight: 'bold', color: 'rgba(42,212,238,0.55)', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace', lineHeight: 1 }}>01</Text>
            <Text style={{ fontSize: 13, color: 'rgba(232,238,249,0.42)', letterSpacing: 3, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace', paddingBottom: 8 }}>PAGES 03 – 10</Text>
        </Box>
        <Box style={{ marginTop: 16, flexDirection: 'column', gap: 10 }}>
            {['messages 里的四种 role', '无状态与上下文窗口', '四个必记的核心概念', '两种调用方式与 Function Calling'].map((t, i) => (
                <Box key={i} style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
                    <Box style={{ width: 18, height: 1, background: 'rgba(42,212,238,0.6)' }} />
                    <Text style={{ fontSize: 16, color: 'rgba(232,238,249,0.82)' }}>{t}</Text>
                </Box>
            ))}
        </Box>
    </Box>

    <Text style={{ position: 'absolute', left: 88, top: 674, fontSize: 14, color: 'rgba(232,238,249,0.42)', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>03 / 45</Text>
