<Slide style={{ width: 1280, height: 720, padding: '20px 72px', flexDirection: 'column', background: 'linear-gradient(160deg, #0B1220 0%, #16233D 100%)', fontFamily: '"Source Han Sans SC", "Noto Sans SC", "Microsoft YaHei", sans-serif' }}>
    {/* A 区 · 标题块 */}
    <Box style={{ height: 100, flexDirection: 'row', gap: 16, alignItems: 'flex-start', paddingTop: 6 }}>
        <Box style={{ width: 4, height: 36, background: '#2AD4EE', marginTop: 5 }} />
        <Box style={{ flexDirection: 'column' }}>
            <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#E8EEF9' }}>工具与记忆：手脚和上下文</Text>
            <Text style={{ marginTop: 8, fontSize: 17, color: 'rgba(232,238,249,0.52)' }}>真正干活的地方，和真正决定成本的地方</Text>
        </Box>
    </Box>

    {/* B 区 · 非对称双栏 58:42 */}
    <Box style={{ height: 516, flexDirection: 'row', gap: 36 }}>
        {/* 左：工具 */}
        <Box style={{ flex: 58, flexDirection: 'column', paddingRight: 32, borderRight: '1px solid rgba(232,238,249,0.12)' }}>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                <FAIcon name='wrench' style={{ fill: '#2AD4EE', width: 18, height: 18 }} />
                <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#E8EEF9' }}>工具：手脚</Text>
                <Text style={{ fontSize: 14, color: 'rgba(232,238,249,0.42)', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>TOOLS</Text>
            </Box>
            <Box style={{ flexDirection: 'column', justifyContent: 'space-between', flex: 1, marginTop: 10 }}>
                {[
                    { t: '小而专', d: 'search_order + refund_order 优于 handle_anything。一个工具干一件事，模型才用得准。' },
                    { t: '描述大于实现', d: 'description 就是给模型看的 API 文档。模型选错工具，90% 的原因是这里写得烂。' },
                    { t: '参数先校验再执行', d: '模型真的会瞎传参数，类型与范围都要验；「合法」也不等于「安全」。' },
                    { t: '失败要回喂，不要吞', d: '工具抛错别让程序崩，把报错拼回上下文，让模型下一轮自己调整。' },
                ].map((c, i) => (
                    <Box key={i} style={{ flexDirection: 'row', gap: 16, alignItems: 'flex-start', paddingTop: 10, paddingBottom: 10, borderBottom: i === 3 ? 'none' : '1px solid rgba(232,238,249,0.08)' }}>
                        <Text style={{ fontSize: 18, color: '#2AD4EE', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace', width: 34 }}>0{i + 1}</Text>
                        <Box style={{ flexDirection: 'column', flex: 1 }}>
                            <Text style={{ fontSize: 19, fontWeight: '600', color: '#E8EEF9' }}>{c.t}</Text>
                            <Text style={{ marginTop: 5, fontSize: 15, color: 'rgba(232,238,249,0.64)', lineHeight: 1.6 }}>{c.d}</Text>
                        </Box>
                    </Box>
                ))}
            </Box>
        </Box>

        {/* 右：记忆 */}
        <Box style={{ flex: 42, flexDirection: 'column' }}>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                <FAIcon name='layer-group' style={{ fill: '#2AD4EE', width: 18, height: 18 }} />
                <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#E8EEF9' }}>记忆：上下文</Text>
                <Text style={{ fontSize: 14, color: 'rgba(232,238,249,0.42)', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>MEMORY</Text>
            </Box>

            <Box style={{ marginTop: 20, flexDirection: 'column', gap: 14 }}>
                {[
                    { k: '近期', v: '原文', w: '100%', d: 'system + 历史 + 本轮 messages' },
                    { k: '远期', v: '摘要', w: '76%', d: '超窗裁剪 / compaction 压缩' },
                    { k: '事实', v: '卡片', w: '54%', d: '结构化字段，稳定可查' },
                    { k: '知识', v: '向量库', w: '34%', d: 'Embedding 检索 topK' },
                ].map((r, i) => (
                    <Box key={i} style={{ flexDirection: 'column', gap: 7 }}>
                        <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 10 }}>
                            <Text style={{ fontSize: 17, fontWeight: '600', color: '#E8EEF9' }}>{r.k} → {r.v}</Text>
                            <Text style={{ fontSize: 14, color: 'rgba(232,238,249,0.52)' }}>{r.d}</Text>
                        </Box>
                        <Box style={{ height: 8, width: r.w, background: 'linear-gradient(90deg, #2AD4EE 0%, rgba(42,212,238,0.15) 100%)', borderRadius: 2 }} />
                    </Box>
                ))}
            </Box>

            <Box style={{ marginTop: 'auto', paddingTop: 16, paddingBottom: 16, paddingLeft: 18, paddingRight: 18, background: 'rgba(22,35,61,0.95)', border: '1px solid rgba(42,212,238,0.35)', borderRadius: 4 }}>
                <Text style={{ fontSize: 15, color: '#2AD4EE', letterSpacing: 2, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>口诀</Text>
                <Text style={{ marginTop: 10, fontSize: 17, color: '#E8EEF9', lineHeight: 1.65 }}>
                    近期带原文，远期压摘要；
                    <br />
                    事实存卡片，知识进向量库。
                </Text>
            </Box>
        </Box>
    </Box>

    {/* C 区 · 页脚 */}
    <Box style={{ height: 40, flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: 'rgba(232,238,249,0.42)' }}>从 LLM 到 Agent 再到 Pi Agent</Text>
        <Text style={{ fontSize: 14, color: 'rgba(232,238,249,0.42)', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>14 / 45</Text>
    </Box>
</Slide>
