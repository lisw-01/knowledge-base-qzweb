<Slide style={{ width: 1280, height: 720, padding: '20px 72px', flexDirection: 'column', background: 'linear-gradient(160deg, #0B1220 0%, #16233D 100%)', fontFamily: '"Source Han Sans SC", "Noto Sans SC", "Microsoft YaHei", sans-serif' }}>
    {/* A 区 · 标题块 */}
    <Box style={{ height: 100, flexDirection: 'row', gap: 16, alignItems: 'flex-start', paddingTop: 6 }}>
        <Box style={{ width: 4, height: 36, background: '#2AD4EE', marginTop: 5 }} />
        <Box style={{ flexDirection: 'column' }}>
            <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#E8EEF9' }}>避坑清单与上线自查</Text>
            <Text style={{ marginTop: 8, fontSize: 17, color: 'rgba(232,238,249,0.52)' }}>左边是写之前要记住的，右边是发之前要打勾的</Text>
        </Box>
    </Box>

    {/* B 区 · 左标题 + 右双列清单 */}
    <Box style={{ height: 516, flexDirection: 'row', gap: 34 }}>
        {/* 左：标题栏 */}
        <Box style={{ width: 268, flexDirection: 'column', paddingRight: 28, borderRight: '1px solid rgba(232,238,249,0.12)' }}>
            <Text style={{ fontSize: 15, color: '#2AD4EE', letterSpacing: 3, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>CHECKLIST</Text>
            <Text style={{ marginTop: 18, fontSize: 26, fontWeight: 'bold', color: '#E8EEF9', lineHeight: 1.45 }}>
                两份清单
                <br />
                十四条勾
            </Text>
            <Text style={{ marginTop: 18, fontSize: 16, color: 'rgba(232,238,249,0.72)', lineHeight: 1.75 }}>
                左边的七条几乎不花成本，但能省下大量排查时间；右边的七条是「敢给别人用」的最低门槛。
            </Text>
            <Box style={{ marginTop: 'auto', paddingTop: 16, paddingBottom: 16, paddingLeft: 16, paddingRight: 16, background: 'rgba(42,212,238,0.08)', border: '1px solid rgba(42,212,238,0.22)', borderRadius: 4 }}>
                <Text style={{ fontSize: 14, color: '#2AD4EE', letterSpacing: 3, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>所以</Text>
                <Text style={{ marginTop: 10, fontSize: 16, color: '#E8EEF9', lineHeight: 1.7 }}>
                    全部打勾，才算从「能跑的 demo」变成「敢给别人用的 Agent」。
                </Text>
            </Box>
        </Box>

        {/* 右：双列清单 */}
        <Box style={{ flex: 1, flexDirection: 'row', gap: 30 }}>
            {[
                {
                    tag: 'BEFORE YOU BUILD',
                    title: '开发避坑 · 七条',
                    items: [
                        ['不要一开始就上框架', '先手写 ReAct，否则出问题完全不会排查'],
                        ['工具描述写清楚', '模型选错工具，90% 是因为 description 写得烂'],
                        ['循环要有终止条件', '最大轮数兜底，防止死循环烧 token'],
                        ['temperature 设 0', '工具调用与结构化输出都要确定性'],
                        ['幻觉应对', '强制模型基于工具返回的真实数据作答'],
                        ['上下文膨胀', '多轮工具调用后及时摘要压缩'],
                        ['危险操作加确认', '执行前让用户点一下，或加白名单'],
                    ],
                },
                {
                    tag: 'BEFORE YOU SHIP',
                    title: '上线自查 · 七条',
                    items: [
                        ['有兜底', '最大轮数 / token 上限，防死循环烧钱'],
                        ['不崩程序', '工具报错被回喂给模型，而不是抛出异常'],
                        ['先校验再执行', '模型输出的格式、类型、范围都验一遍'],
                        ['人工确认位', '删除、支付、对外发消息必须过人'],
                        ['日志可回放', '每轮 Thought / Action / Observation 落盘'],
                        ['密钥与提示词归位', 'key 不在代码里，prompt 不散落在业务代码'],
                        ['回归测试集', '有固定问题集，改 prompt / 换模型后能回归'],
                    ],
                },
            ].map((g, gi) => (
                <Box key={gi} style={{ flex: 1, flexDirection: 'column' }}>
                    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                        <Box style={{ width: 22, height: 22, borderRadius: 11, background: gi === 0 ? 'rgba(42,212,238,0.14)' : 'rgba(42,212,238,0.28)', alignItems: 'center', justifyContent: 'center' }}>
                            <Text style={{ fontSize: 12, color: '#2AD4EE', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>{gi + 1}</Text>
                        </Box>
                        <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#E8EEF9' }}>{g.title}</Text>
                    </Box>
                    <Text style={{ marginTop: 8, fontSize: 13, color: 'rgba(232,238,249,0.38)', letterSpacing: 2, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>{g.tag}</Text>

                    <Box style={{ flex: 1, marginTop: 12, flexDirection: 'column', justifyContent: 'space-between' }}>
                        {g.items.map((it, i) => (
                            <Box key={i} style={{ flexDirection: 'row', gap: 11, alignItems: 'flex-start' }}>
                                <FAIcon name='circle-check' style={{ fill: gi === 0 ? 'rgba(42,212,238,0.7)' : '#2AD4EE', width: 16, height: 16, marginTop: 3 }} />
                                <Text style={{ flex: 1, fontSize: 15, color: 'rgba(232,238,249,0.66)', lineHeight: 1.55 }}>
                                    <span style={{ color: '#E8EEF9', fontWeight: '600' }}>{it[0]}</span>
                                    <span style={{ color: 'rgba(232,238,249,0.45)' }}> · </span>
                                    {it[1]}
                                </Text>
                            </Box>
                        ))}
                    </Box>
                </Box>
            ))}
        </Box>
    </Box>

    {/* C 区 · 页脚 */}
    <Box style={{ height: 40, flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: 'rgba(232,238,249,0.42)' }}>从 LLM 到 Agent 再到 Pi Agent</Text>
        <Text style={{ fontSize: 14, color: 'rgba(232,238,249,0.42)', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>19 / 45</Text>
    </Box>
</Slide>
