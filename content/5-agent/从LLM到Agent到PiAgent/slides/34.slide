<Slide style={{ width: 1280, height: 720, padding: '20px 72px', flexDirection: 'column', background: 'linear-gradient(160deg, #0B1220 0%, #16233D 100%)', fontFamily: '"Source Han Sans SC", "Noto Sans SC", "Microsoft YaHei", sans-serif' }}>
    {/* A 区 */}
    <Box style={{ height: 100, flexDirection: 'row', gap: 16, alignItems: 'flex-start', paddingTop: 6 }}>
        <Box style={{ width: 4, height: 36, background: '#2AD4EE', marginTop: 5 }} />
        <Box style={{ flexDirection: 'column' }}>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
                <Text style={{ fontSize: 13, color: '#2AD4EE', letterSpacing: 3, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>DESIGN POINT 06</Text>
                <Text style={{ fontSize: 13, color: 'rgba(232,238,249,0.38)', letterSpacing: 2, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>· 对应 ⑥ 护栏层</Text>
            </Box>
            <Text style={{ marginTop: 6, fontSize: 34, fontWeight: 'bold', color: '#E8EEF9' }}>扩展系统：一个函数，一张虚拟模块表</Text>
        </Box>
    </Box>

    {/* B 区 */}
    <Box style={{ height: 516, flexDirection: 'column' }}>
        <Box style={{ height: 452, flexDirection: 'row', gap: 26 }}>

            {/* 左：形态与 API */}
            <Box style={{ width: 512, flexDirection: 'column', paddingRight: 24, borderRight: '1px solid rgba(232,238,249,0.12)' }}>
                <Text style={{ fontSize: 14, color: '#2AD4EE', letterSpacing: 2.5, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>EXTENSION · 一个函数</Text>

                <CodeBlock
                    code={`export default function (pi: ExtensionAPI) {
  pi.on("tool_call", async (e) => {
    if (isDangerous(e)) return { block: true, reason: "blocked" };
  });
  pi.registerTool({ name: "my_tool", ... });
  pi.registerCommand("mycommand", { handler });
}`}
                    language='typescript'
                    width={488}
                    fontSize={12}
                    theme='github-dark'
                />

                <Text style={{ marginTop: 12, fontSize: 13, color: 'rgba(232,238,249,0.46)' }}>自动发现位置 · 不用注册</Text>
                <Box style={{ marginTop: 7, flexDirection: 'column', gap: 4 }}>
                    {[
                        ['~/.pi/agent/extensions/', '全局，个人偏好'],
                        ['<cwd>/.pi/extensions/', '项目级，随 git 走'],
                        ['settings.json', 'extensions 数组指定路径'],
                        ['pi install <pkg>', '社区包，一条命令'],
                    ].map((r, i) => (
                        <Box key={i} style={{ flexDirection: 'row', gap: 8 }}>
                            <Text style={{ width: 218, fontSize: 11.5, color: '#2AD4EE', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>{r[0]}</Text>
                            <Text style={{ flex: 1, fontSize: 11.5, color: 'rgba(232,238,249,0.58)' }}>{r[1]}</Text>
                        </Box>
                    ))}
                </Box>

                <Text style={{ marginTop: 10, fontSize: 12, color: 'rgba(232,238,249,0.46)' }}>可订阅事件 · 覆盖全生命周期（还能注册 CLI flags 与 UI 组件）</Text>
                <Box style={{ marginTop: 6, flexDirection: 'row', gap: 5, flexWrap: 'wrap' }}>
                    {['session_*', 'agent_*', 'before_agent_start', 'before_provider_request', 'tool_call', 'tool_result', 'turn_*', 'message_*', 'input', 'context'].map((t, i) => (
                        <Box key={i} style={{ paddingTop: 3, paddingBottom: 3, paddingLeft: 7, paddingRight: 7, background: 'rgba(42,212,238,0.07)', borderRadius: 2 }}>
                            <Text style={{ fontSize: 10, color: 'rgba(232,238,249,0.66)', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>{t}</Text>
                        </Box>
                    ))}
                </Box>

                <Box style={{ marginTop: 'auto', paddingTop: 11, paddingBottom: 11, paddingLeft: 14, paddingRight: 14, background: 'rgba(42,212,238,0.07)', border: '1px solid rgba(42,212,238,0.20)', borderRadius: 3 }}>
                    <Text style={{ fontSize: 12.5, color: 'rgba(232,238,249,0.82)', lineHeight: 1.6 }}>
                        内核刻意不做 MCP、子代理、权限弹窗——它们全是扩展。
                        <span style={{ color: '#2AD4EE' }}>内核极小 + 扩展面全开</span>
                        ，是同一枚硬币的两面。
                    </Text>
                </Box>
            </Box>

            {/* 右：virtual modules */}
            <Box style={{ flex: 1, flexDirection: 'column' }}>
                <Box style={{ flexDirection: 'row', alignItems: 'baseline', justifyContent: 'space-between' }}>
                    <Text style={{ fontSize: 14, color: '#2AD4EE', letterSpacing: 2.5, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>VIRTUAL MODULES · 依赖注入</Text>
                    <Text style={{ fontSize: 12, color: 'rgba(232,238,249,0.42)' }}>jiti + 一张映射表</Text>
                </Box>

                <Text style={{ marginTop: 8, fontSize: 12.5, color: 'rgba(232,238,249,0.56)', lineHeight: 1.55 }}>
                    扩展是运行时才加载的裸 .ts 文件，没有 node_modules。按 Node 规则，第一行 import 就会 MODULE_NOT_FOUND。
                </Text>

                <Box style={{ marginTop: 10, flexDirection: 'row', gap: 9 }}>
                    <Box style={{ flex: 1, paddingTop: 9, paddingBottom: 9, paddingLeft: 11, paddingRight: 11, background: 'rgba(22,35,61,0.60)', border: '1px solid rgba(232,238,249,0.08)', borderRadius: 3 }}>
                        <Text style={{ fontSize: 11, color: 'rgba(232,238,249,0.44)' }}>方案 A · peerDependencies</Text>
                        <Text style={{ marginTop: 4, fontSize: 11.5, color: 'rgba(232,238,249,0.60)', lineHeight: 1.5 }}>用户自己装、版本要自己对齐。依赖地狱。</Text>
                    </Box>
                    <Box style={{ flex: 1.2, paddingTop: 9, paddingBottom: 9, paddingLeft: 11, paddingRight: 11, background: 'rgba(255,120,120,0.05)', border: '1px solid rgba(255,140,140,0.22)', borderRadius: 3 }}>
                        <Text style={{ fontSize: 11, color: 'rgba(255,160,160,0.72)' }}>方案 B · 扩展自带一份</Text>
                        <Text style={{ marginTop: 4, fontSize: 11.5, color: 'rgba(232,238,249,0.60)', lineHeight: 1.5 }}>
                            双实例灾难：两个事件总线、两个工具表。扩展手里的工具表，宿主循环看不见，拦截静默失效。
                        </Text>
                    </Box>
                    <Box style={{ flex: 1, paddingTop: 9, paddingBottom: 9, paddingLeft: 11, paddingRight: 11, background: 'rgba(42,212,238,0.10)', border: '1px solid rgba(42,212,238,0.30)', borderRadius: 3 }}>
                        <Text style={{ fontSize: 11, color: '#2AD4EE' }}>方案 C · virtual modules</Text>
                        <Text style={{ marginTop: 4, fontSize: 11.5, color: 'rgba(232,238,249,0.76)', lineHeight: 1.5 }}>宿主把自己正在运行的模块实例直接递过去。</Text>
                    </Box>
                </Box>

                <Box style={{ marginTop: 9 }}>
                    <CodeBlock
                        code={`const VIRTUAL_MODULES = {
  typebox:                       bundledTypebox,
  "@earendil-works/pi-ai":       bundledPiAiCompat,
  "@earendil-works/pi-agent-core": bundledPiAgentCore,
  "@earendil-works/pi-coding-agent": bundledPiCodingAgent,
};
// jiti 解析 import 先查这张表，命中就不碰磁盘`}
                        language='typescript'
                        width={668}
                        fontSize={11}
                        theme='github-dark'
                    />
                </Box>

                <Box style={{ marginTop: 9, flexDirection: 'row', gap: 8, flexWrap: 'wrap' }}>
                    {['单文件二进制: virtualModules', '源码运行: + tsconfigPaths', 'dist 安装: alias 到同一文件'].map((t, i) => (
                        <Box key={i} style={{ paddingTop: 4, paddingBottom: 4, paddingLeft: 8, paddingRight: 8, background: 'rgba(232,238,249,0.05)', borderRadius: 2 }}>
                            <Text style={{ fontSize: 10.5, color: 'rgba(232,238,249,0.60)' }}>{t}</Text>
                        </Box>
                    ))}
                </Box>

                <Text style={{ marginTop: 'auto', fontSize: 11.5, color: 'rgba(232,238,249,0.52)', lineHeight: 1.5 }}>
                    代价：注入粒度从实例升到模块，时机从构造提前到 import 解析。
                </Text>
            </Box>
        </Box>

        {/* 底部 */}
        <Box style={{ height: 52, marginTop: 8, flexDirection: 'row', alignItems: 'center', gap: 14, paddingLeft: 18, paddingRight: 18, background: 'rgba(42,212,238,0.08)', border: '1px solid rgba(42,212,238,0.22)', borderRadius: 4 }}>
            <Text style={{ fontSize: 13, color: '#2AD4EE', letterSpacing: 2, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>要点</Text>
            <Text style={{ flex: 1, fontSize: 15, color: '#E8EEF9', lineHeight: 1.5 }}>
                插件与宿主要共享的不是「同一个版本号」，而是<span style={{ color: '#2AD4EE' }}>同一个对象</span>——否则 instanceof 失效、拦截静默丢失。
            </Text>
        </Box>
    </Box>

    {/* C 区 */}
    <Box style={{ height: 40, flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: 'rgba(232,238,249,0.42)' }}>从 LLM 到 Agent 再到 Pi Agent</Text>
        <Text style={{ fontSize: 14, color: 'rgba(232,238,249,0.42)', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>34 / 45</Text>
    </Box>
</Slide>
