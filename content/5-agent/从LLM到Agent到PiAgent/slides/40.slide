<Slide style={{ width: 1280, height: 720, padding: '20px 72px', flexDirection: 'column', background: 'linear-gradient(160deg, #0B1220 0%, #16233D 100%)', fontFamily: '"Source Han Sans SC", "Noto Sans SC", "Microsoft YaHei", sans-serif' }}>
    {/* A 区 · 标题块 */}
    <Box style={{ height: 100, flexDirection: 'row', gap: 16, alignItems: 'flex-start', paddingTop: 6 }}>
        <Box style={{ width: 4, height: 36, background: '#2AD4EE', marginTop: 5 }} />
        <Box style={{ flexDirection: 'column' }}>
            <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#E8EEF9' }}>三级路由：准确性的核心</Text>
            <Text style={{ marginTop: 8, fontSize: 17, color: 'rgba(232,238,249,0.52)' }}>按顺序判断，不得跳级；缺参数就不调工具</Text>
        </Box>
    </Box>

    {/* B 区 */}
    <Box style={{ height: 516, flexDirection: 'row', gap: 34 }}>
        {/* 左：巨型数字 + 判断 */}
        <Box style={{ width: 336, flexDirection: 'column', paddingRight: 32, borderRight: '1px solid rgba(232,238,249,0.12)' }}>
            <Text style={{ fontSize: 15, color: '#2AD4EE', letterSpacing: 3, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>ROUTING BY PRIORITY</Text>
            <Text style={{ marginTop: 10, fontSize: 96, fontWeight: 'bold', color: '#2AD4EE', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace', lineHeight: 1 }}>三级</Text>
            <Text style={{ marginTop: 16, fontSize: 21, fontWeight: 'bold', color: '#E8EEF9', lineHeight: 1.5 }}>
                强约束优先，
                <br />
                自由 SQL 兜底
            </Text>
            <Text style={{ marginTop: 16, fontSize: 16, color: 'rgba(232,238,249,0.72)', lineHeight: 1.75 }}>
                越往上，模型能编造的空间越小。自由 SQL 永远放在最后，而且一定会被 AST 校验和范围注入重写一遍。
            </Text>
            <Box style={{ marginTop: 'auto', paddingTop: 16, paddingBottom: 16, paddingLeft: 18, paddingRight: 18, background: 'rgba(42,212,238,0.08)', border: '1px solid rgba(42,212,238,0.22)', borderRadius: 4 }}>
                <Text style={{ fontSize: 15, color: '#2AD4EE', letterSpacing: 3, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>所以</Text>
                <Text style={{ marginTop: 10, fontSize: 17, color: '#E8EEF9', lineHeight: 1.7 }}>
                    把「选哪条路」从模型手里收回来，才是准不准的关键。
                </Text>
            </Box>
        </Box>

        {/* 右：三级阶梯 */}
        <Box style={{ flex: 1, flexDirection: 'column' }}>
            <Box style={{ flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
                <Text style={{ fontSize: 15, color: 'rgba(232,238,249,0.52)', letterSpacing: 2, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>DECISION ORDER · 自上而下，命中即停</Text>
                <Text style={{ fontSize: 13, color: 'rgba(232,238,249,0.42)' }}>跳级 = 准确率失控</Text>
            </Box>

            <Box style={{ flex: 1, marginTop: 12, flexDirection: 'column' }}>
                {[
                    { n: '①', t: '业务 API', tool: 'call_business_api', badge: '强约束', d: '先看问题是否命中租户的业务 API 清单；字典类 API 可直接按名调用。参数齐全才执行。' },
                    { n: '②', t: '指标模板', tool: 'query_metric', badge: '中等约束', d: '未命中 API，再看是否命中预定义指标字典；检查维度 / 时间 / 过滤参数是否齐全。' },
                    { n: '③', t: '受控 SQL', tool: 'run_safe_sql', badge: '受控兜底', d: '前两级都没命中才走自由 SQL；AST 校验 + 强制注入租户与数据范围后执行。' },
                ].map((r, i) => (
                    <Box key={i} style={{ flex: 1, flexDirection: 'column' }}>
                        <Box style={{ flex: 1, flexDirection: 'row', alignItems: 'center', gap: 16, paddingLeft: 18, paddingRight: 18, background: i === 0 ? 'rgba(42,212,238,0.13)' : 'rgba(22,35,61,0.94)', border: i === 0 ? '1px solid rgba(42,212,238,0.45)' : '1px solid rgba(232,238,249,0.10)', borderLeft: '4px solid #2AD4EE', borderRadius: 3 }}>
                            <Text style={{ width: 34, fontSize: 30, color: '#2AD4EE', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace', lineHeight: 1 }}>{r.n}</Text>
                            <Box style={{ flexDirection: 'column', flex: 1 }}>
                                <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 12 }}>
                                    <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#E8EEF9' }}>{r.t}</Text>
                                    <Text style={{ fontSize: 14, color: '#2AD4EE', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>{r.tool}</Text>
                                </Box>
                                <Text style={{ marginTop: 6, fontSize: 13.5, color: 'rgba(232,238,249,0.60)', lineHeight: 1.5 }}>{r.d}</Text>
                            </Box>
                            <Box style={{ paddingTop: 4, paddingBottom: 4, paddingLeft: 10, paddingRight: 10, background: 'rgba(42,212,238,0.10)', border: '1px solid rgba(42,212,238,0.28)', borderRadius: 3 }}>
                                <Text style={{ fontSize: 12.5, color: '#2AD4EE' }}>{r.badge}</Text>
                            </Box>
                        </Box>
                        {i < 2 && (
                            <Box style={{ height: 28, flexDirection: 'row', alignItems: 'center', paddingLeft: 34, gap: 10 }}>
                                <Text style={{ fontSize: 13, color: 'rgba(42,212,238,0.7)', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>↓ 未命中</Text>
                            </Box>
                        )}
                    </Box>
                ))}
            </Box>

            <Box style={{ height: 68, marginTop: 12, flexDirection: 'row', alignItems: 'center', gap: 20, paddingLeft: 18, paddingRight: 18, background: 'rgba(42,212,238,0.06)', borderLeft: '3px solid rgba(42,212,238,0.6)' }}>
                <Text style={{ fontSize: 13, color: '#2AD4EE', letterSpacing: 2, fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>两条铁律</Text>
                <Text style={{ flex: 1, fontSize: 15, color: 'rgba(232,238,249,0.76)', lineHeight: 1.6 }}>
                    <span style={{ color: '#E8EEF9', fontWeight: '600' }}>不得跳级</span>：只能按 ①→②→③ 顺序判断 ｜
                    <span style={{ color: '#E8EEF9', fontWeight: '600' }}>缺参不调工具</span>：先向用户索要，补齐后重新判断
                </Text>
            </Box>
        </Box>
    </Box>

    {/* C 区 · 页脚 */}
    <Box style={{ height: 40, flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: 'rgba(232,238,249,0.42)' }}>从 LLM 到 Agent 再到 Pi Agent</Text>
        <Text style={{ fontSize: 14, color: 'rgba(232,238,249,0.42)', fontFamily: '"JetBrains Mono", "Cascadia Mono", Consolas, monospace' }}>40 / 45</Text>
    </Box>
</Slide>
